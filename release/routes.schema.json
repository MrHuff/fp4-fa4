{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "routes.schema.json",
  "title": "FP4 FA4 retained route catalog",
  "description": "Schema for the source, ABI, evidence, and promotion boundary of each decision-relevant FA4 route family in this release.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_date",
    "catalog_scope",
    "status_definitions",
    "routes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "catalog_date": {
      "type": "string",
      "format": "date"
    },
    "catalog_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition", "source_epochs", "selection_rule"],
      "properties": {
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "source_epochs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "selection_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status_definitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_control",
        "release_candidate",
        "historical_replay",
        "pinned_comparator",
        "operator_only",
        "diagnostic",
        "disabled_fail_closed",
        "preserved_unpromoted"
      ],
      "properties": {
        "reference_control": {"type": "string", "minLength": 1},
        "release_candidate": {"type": "string", "minLength": 1},
        "historical_replay": {"type": "string", "minLength": 1},
        "pinned_comparator": {"type": "string", "minLength": 1},
        "operator_only": {"type": "string", "minLength": 1},
        "diagnostic": {"type": "string", "minLength": 1},
        "disabled_fail_closed": {"type": "string", "minLength": 1},
        "preserved_unpromoted": {"type": "string", "minLength": 1}
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/route"
      }
    }
  },
  "$defs": {
    "repo_path": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[^/].+",
      "not": {
        "pattern": "(^|/)\\.\\.(/|$)"
      }
    },
    "path_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repo_path"
      }
    },
    "positive_integer_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "shape_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "constraint"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "constraint": {
          "type": "string",
          "minLength": 1
        },
        "batch": {
          "$ref": "#/$defs/positive_integer_list"
        },
        "sequence": {
          "$ref": "#/$defs/positive_integer_list"
        },
        "query_heads": {
          "$ref": "#/$defs/positive_integer_list"
        },
        "key_value_heads": {
          "$ref": "#/$defs/positive_integer_list"
        },
        "head_dimension": {
          "$ref": "#/$defs/positive_integer_list"
        }
      }
    },
    "internal_family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "version"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portable_build", "torchtitan_dispatch", "paper_use"],
      "properties": {
        "portable_build": {
          "type": "boolean"
        },
        "torchtitan_dispatch": {
          "enum": [
            "matched_control",
            "release_candidate",
            "diagnostic_only",
            "not_connected",
            "forced_safe_fallback"
          ]
        },
        "paper_use": {
          "enum": [
            "reference_control",
            "headline_method",
            "comparator",
            "diagnostic_or_ablation",
            "excluded_from_claims"
          ]
        }
      }
    },
    "precision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "learned_projections": {"type": "string", "minLength": 1},
        "qk": {"type": "string", "minLength": 1},
        "pv": {"type": "string", "minLength": 1},
        "gradient_operands": {"type": "string", "minLength": 1},
        "dout": {"type": "string", "minLength": 1},
        "outputs": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "supports", "limitations"],
      "properties": {
        "path": {
          "$ref": "#/$defs/repo_path"
        },
        "supports": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "human_name",
        "internal_family",
        "phase",
        "attention_mode",
        "status",
        "summary",
        "selection",
        "shape_profiles",
        "precision",
        "source_paths",
        "build_paths",
        "benchmark_paths",
        "test_paths",
        "abi_and_numerics",
        "evidence",
        "known_limits",
        "promotion_criteria"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "human_name": {
          "type": "string",
          "minLength": 1
        },
        "internal_family": {
          "$ref": "#/$defs/internal_family"
        },
        "phase": {
          "enum": ["control", "forward", "backward", "forward_backward"]
        },
        "attention_mode": {
          "enum": ["causal", "noncausal", "causal_and_noncausal"]
        },
        "status": {
          "enum": [
            "reference_control",
            "release_candidate",
            "historical_replay",
            "pinned_comparator",
            "operator_only",
            "diagnostic",
            "disabled_fail_closed",
            "preserved_unpromoted"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "selection": {
          "$ref": "#/$defs/selection"
        },
        "shape_profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/shape_profile"
          }
        },
        "precision": {
          "$ref": "#/$defs/precision"
        },
        "source_paths": {
          "allOf": [
            {"$ref": "#/$defs/path_list"},
            {"minItems": 1}
          ]
        },
        "build_paths": {
          "$ref": "#/$defs/path_list"
        },
        "benchmark_paths": {
          "$ref": "#/$defs/path_list"
        },
        "test_paths": {
          "$ref": "#/$defs/path_list"
        },
        "abi_and_numerics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "known_limits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "promotion_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
