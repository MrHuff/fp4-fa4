%----------------------------------------------------------
% PACKAGE CONFIGURATION
%----------------------------------------------------------

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{gc/article-envs}[2024/05/22]

%----------------------------------------------------------
% COLORS
%----------------------------------------------------------

\RequirePackage{xcolor}
\definecolor{gcblue}{RGB}{181, 228, 235}
\definecolor{gcpink}{RGB}{255, 111, 121}
\definecolor{gcorange}{RGB}{251, 195, 170}
\definecolor{gcyellow}{RGB}{251, 232, 170}
\definecolor{gcdarkgrey}{RGB}{41, 44, 49}
\definecolor{gclightgrey}{RGB}{250, 248, 249}

%----------------------------------------------------------
% TAUENV-, INFO-, NOTE- ENVIRONMENTS
%----------------------------------------------------------

% gcenv
\newmdenv[
    backgroundcolor=gclightgrey,
    linecolor=gcdarkgrey,
    linewidth=0.7pt,
    frametitle=\vskip0pt\bfseries,
    frametitlerule=false,
    frametitlefont=\color{gcpink}\bfseries\sffamily,
    frametitlealignment=\raggedright,
    innertopmargin=3pt,
    innerbottommargin=6pt,
    innerleftmargin=6pt,
    innerrightmargin=6pt,
    font=\selectfont,
    fontcolor=black,
    frametitleaboveskip=8pt,
    skipabove=10pt
]{gcenv}

%----------------------------------------------------------

% Info
\newmdenv[
    backgroundcolor=gclightgrey,
    linecolor=gcdarkgrey,
    linewidth=0.7pt,
    frametitle=\vskip0pt\bfseries Info,
