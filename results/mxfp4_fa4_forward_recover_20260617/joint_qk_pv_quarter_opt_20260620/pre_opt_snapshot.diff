+def make_mxfp4_tcgen_shape_debug_inputs(
+    *,
+    rows: int,
+    n_tile: int,
+    k_tile: int,
+    seed: int = 0,
+    device: str | torch.device = "cuda",
+    quant_mode: str | None = None,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Create real MXFP4 payloads/scales for the standalone TCGEN shape debug kernel."""
+    if rows % _TILE != 0:
+        raise ValueError("rows must be divisible by 128")
+    if n_tile not in (128, 256, 512):
+        raise ValueError("n_tile must be 128, 256, or 512")
+    if k_tile not in (64, 128, 256):
+        raise ValueError("k_tile must be 64, 128, or 256")
+    resolved_device = torch.device(device)
+    gen = torch.Generator(device=resolved_device)
+    gen.manual_seed(int(seed))
+    a_bf16 = torch.randn((rows, k_tile), device=resolved_device, dtype=torch.bfloat16, generator=gen)
+    b_bf16 = torch.randn((n_tile, k_tile), device=resolved_device, dtype=torch.bfloat16, generator=gen)
+    a_rec = _quantize_rows_2d_mxfp4(
+        a_bf16,
+        backend="mxfp4",
+        quant_mode=quant_mode,
+        pad_cols_to_tile=(k_tile < _TILE),
+    )
+    b_rec = _quantize_rows_2d_mxfp4(
+        b_bf16,
+        backend="mxfp4",
+        quant_mode=quant_mode,
+        pad_cols_to_tile=(k_tile < _TILE),
+    )
+    return (
+        a_rec["fp4"].contiguous(),
+        a_rec["scales"].contiguous(),
+        b_rec["fp4"].contiguous(),
+        b_rec["scales"].contiguous(),
+    )
+
+
+def _native_mxfp4_tcgen_shape_debug(
+    a_fp4: torch.Tensor,
+    a_sc: torch.Tensor,
+    b_fp4: torch.Tensor,
+    b_sc: torch.Tensor,
+    *,
+    k_tile: int,
+    n_tile: int,
+    ncta: int,
+    scale_layout: int = 0,
+    debug_stage: int = 0,
+) -> torch.Tensor:
+    ext = _load_forward_experiments_ext()
+    _check_cuda_contiguous(a_fp4, "a_fp4")
+    _check_cuda_contiguous(a_sc, "a_sc")
+    _check_cuda_contiguous(b_fp4, "b_fp4")
+    _check_cuda_contiguous(b_sc, "b_sc")
+    if a_fp4.dtype != torch.float4_e2m1fn_x2 or b_fp4.dtype != torch.float4_e2m1fn_x2:
+        raise ValueError("shape debug expects float4_e2m1fn_x2 payload tensors")
+    if a_sc.dtype != torch.uint8 or b_sc.dtype != torch.uint8:
+        raise ValueError("shape debug expects uint8 E8M0 scale tensors")
+    rows = int(a_fp4.shape[0])
+    out = torch.empty((rows, int(n_tile)), device=a_fp4.device, dtype=torch.bfloat16)
+    with _cuda_device_ctx(a_fp4.device):
+        ext.mxfp4_tcgen_shape_debug(
+            a_fp4,
+            a_sc,
+            b_fp4,
+            b_sc,
+            out,
+            int(k_tile),
+            int(n_tile),
+            int(ncta),
+            int(scale_layout),
+            int(debug_stage),
+        )
+    return out
+
+
+def benchmark_mxfp4_tcgen_shape_debug(
+    *,
+    rows: int = 65536,
+    n_tile: int = 128,
+    k_tile: int = 128,
+    ncta: int = 2,
+    scale_layout: int = 0,
+    debug_stage: int = 0,
+    seed: int = 0,
+    warmup: int = 2,
+    iters: int = 5,
+    device: str | torch.device = "cuda",
+    timeout_ms: float | None = _CUDA_EVENT_TIMEOUT_MS,
+) -> dict[str, Any]:
+    resolved_device = _benchmark_cuda_preflight(
+        device,
+        what="benchmark_mxfp4_tcgen_shape_debug",
+    )
+    a_fp4, a_sc, b_fp4, b_sc = make_mxfp4_tcgen_shape_debug_inputs(
+        rows=rows,
+        n_tile=n_tile,
+        k_tile=k_tile,
+        seed=seed,
+        device=resolved_device,
+    )
+    timeout = _CUDA_EVENT_TIMEOUT_MS if timeout_ms is None else float(timeout_ms)
+
+    def run_once() -> torch.Tensor:
+        return _native_mxfp4_tcgen_shape_debug(
+            a_fp4,
+            a_sc,
+            b_fp4,
+            b_sc,
+            k_tile=k_tile,
+            n_tile=n_tile,
+            ncta=ncta,
+            scale_layout=scale_layout,
+            debug_stage=debug_stage,
+        )
+
+    for _ in range(max(0, warmup)):
+        out = run_once()
+    _wait_for_current_stream(resolved_device, timeout_ms=timeout, what="mxfp4_tcgen_shape_debug warmup")
+
+    samples: list[float] = []
+    out = None
+    stream = torch.cuda.current_stream(device=resolved_device)
+    for _ in range(max(1, iters)):
+        start = torch.cuda.Event(enable_timing=True)
+        end = torch.cuda.Event(enable_timing=True)
+        start.record(stream)
+        out = run_once()
+        end.record(stream)
+        _wait_for_event(end, timeout_ms=timeout, what="mxfp4_tcgen_shape_debug timing")
+        samples.append(float(start.elapsed_time(end)))
+    assert out is not None
+    out_f = out.float()
+    return {
+        "rows": int(rows),
+        "n_tile": int(n_tile),
+        "k_tile": int(k_tile),
+        "ncta": int(ncta),
+        "scale_layout": int(scale_layout),
+        "debug_stage": int(debug_stage),
+        "ms": float(statistics.median(samples)),
+        "samples_ms": samples,
+        "finite": bool(torch.isfinite(out_f).all().item()),
+        "nonzero": bool((out_f.abs().sum() > 0).item()),
+        "abs_sum": float(out_f.abs().sum().item()),
+        "max_abs": float(out_f.abs().max().item()),
+    }
+
