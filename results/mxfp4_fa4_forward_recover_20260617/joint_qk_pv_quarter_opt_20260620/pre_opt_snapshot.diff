+    if (g.debug_stage == 1) {
+        return;
+    }
+
+    load_mxfp4_shape_a_tile<C>(a_smem, g, row_tile);
+    load_mxfp4_shape_b_tile<C>(b_smem, g, cta_rank, 0);
