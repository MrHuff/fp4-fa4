+    k_smem[k_idx], g.k, k_coord, k_arrived[k_idx], (uint16_t)(1 << cta_rank), 0);
+fp4pv_load_async<dim::ROW, cache_policy::NORMAL, C>(
+    slot_tile_at(k_sc_smem, k_sc_idx), g.k_sc, k_sc_coord, k_sc_arrived[k_sc_idx], (uint16_t)(1 << cta_rank), 0);
