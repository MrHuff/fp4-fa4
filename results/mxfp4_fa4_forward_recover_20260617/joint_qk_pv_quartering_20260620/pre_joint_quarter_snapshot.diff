+    static_assert(_ClusterSize == 1 || _ClusterSize == 2, "ClusterSize must be 1 or 2");
+    static_assert(_ScaleLayout == 0 || _ScaleLayout == 1, "ScaleLayout must be 0(compact) or 1(gemm-like)");
+
+    static constexpr int Mb = 128;
