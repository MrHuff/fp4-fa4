+def benchmark_mxfp4_tcgen_shape_debug(
+    *,
+    rows: int = 65536,
+    n_tile: int = 128,
+    k_tile: int = 128,
+    ncta: int = 2,
+    scale_layout: int = 0,
+    debug_stage: int = 0,
+    seed: int = 0,
+    warmup: int = 2,
+    iters: int = 5,
+    device: str | torch.device = "cuda",
+    timeout_ms: float | None = _CUDA_EVENT_TIMEOUT_MS,
+) -> dict[str, Any]:
+    resolved_device = _benchmark_cuda_preflight(
+        device,
+        what="benchmark_mxfp4_tcgen_shape_debug",
+    )
+    a_fp4, a_sc, b_fp4, b_sc = make_mxfp4_tcgen_shape_debug_inputs(
+        rows=rows,
+        n_tile=n_tile,
+        k_tile=k_tile,
+        seed=seed,
+        device=resolved_device,
+    )
+    timeout = _CUDA_EVENT_TIMEOUT_MS if timeout_ms is None else float(timeout_ms)
+
+    def run_once() -> torch.Tensor:
+        return _native_mxfp4_tcgen_shape_debug(
+            a_fp4,
+            a_sc,
+            b_fp4,
+            b_sc,
+            k_tile=k_tile,
+            n_tile=n_tile,
+            ncta=ncta,
+            scale_layout=scale_layout,
+            debug_stage=debug_stage,
+        )
+
+    for _ in range(max(0, warmup)):
+        out = run_once()
+    _wait_for_current_stream(resolved_device, timeout_ms=timeout, what="mxfp4_tcgen_shape_debug warmup")
+
+    samples: list[float] = []
+    out = None
+    stream = torch.cuda.current_stream(device=resolved_device)
+    for _ in range(max(1, iters)):
+        start = torch.cuda.Event(enable_timing=True)
+        end = torch.cuda.Event(enable_timing=True)
+        start.record(stream)
+        out = run_once()
+        end.record(stream)
+        _wait_for_event(end, timeout_ms=timeout, what="mxfp4_tcgen_shape_debug timing")
+        samples.append(float(start.elapsed_time(end)))
+    assert out is not None
+    out_f = out.float()
+    return {
+        "rows": int(rows),
+        "n_tile": int(n_tile),
+        "k_tile": int(k_tile),
+        "ncta": int(ncta),
+        "scale_layout": int(scale_layout),
+        "debug_stage": int(debug_stage),
+        "ms": float(statistics.median(samples)),
+        "samples_ms": samples,
+        "finite": bool(torch.isfinite(out_f).all().item()),
+        "nonzero": bool((out_f.abs().sum() > 0).item()),
+        "abs_sum": float(out_f.abs().sum().item()),
+        "max_abs": float(out_f.abs().max().item()),
+    }
