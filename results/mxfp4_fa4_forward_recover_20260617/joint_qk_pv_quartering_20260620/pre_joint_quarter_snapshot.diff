+    a_rec = _quantize_rows_2d_mxfp4(
+        a_bf16,
+        backend="mxfp4",
+        quant_mode=quant_mode,
+        pad_cols_to_tile=(k_tile < _TILE),
+    )
+    b_rec = _quantize_rows_2d_mxfp4(
+        b_bf16,
+        backend="mxfp4",
+        quant_mode=quant_mode,
+        pad_cols_to_tile=(k_tile < _TILE),
+    )
+    return (
+        a_rec["fp4"].contiguous(),
+        a_rec["scales"].contiguous(),
+        b_rec["fp4"].contiguous(),
+        b_rec["scales"].contiguous(),
+    )
