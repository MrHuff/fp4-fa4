+def _native_mxfp4_tcgen_shape_debug(
+    a_fp4: torch.Tensor,
+    a_sc: torch.Tensor,
+    b_fp4: torch.Tensor,
+    b_sc: torch.Tensor,
+    *,
+    k_tile: int,
+    n_tile: int,
+    ncta: int,
+    scale_layout: int = 0,
+    debug_stage: int = 0,
+) -> torch.Tensor:
+    ext = _load_forward_experiments_ext()
+    _check_cuda_contiguous(a_fp4, "a_fp4")
+    _check_cuda_contiguous(a_sc, "a_sc")
+    _check_cuda_contiguous(b_fp4, "b_fp4")
+    _check_cuda_contiguous(b_sc, "b_sc")
+    if a_fp4.dtype != torch.float4_e2m1fn_x2 or b_fp4.dtype != torch.float4_e2m1fn_x2:
+        raise ValueError("shape debug expects float4_e2m1fn_x2 payload tensors")
+    if a_sc.dtype != torch.uint8 or b_sc.dtype != torch.uint8:
+        raise ValueError("shape debug expects uint8 E8M0 scale tensors")
+    rows = int(a_fp4.shape[0])
+    out = torch.empty((rows, int(n_tile)), device=a_fp4.device, dtype=torch.bfloat16)
+    with _cuda_device_ctx(a_fp4.device):
+        ext.mxfp4_tcgen_shape_debug(
+            a_fp4,
+            a_sc,
+            b_fp4,
+            b_sc,
+            out,
+            int(k_tile),
+            int(n_tile),
+            int(ncta),
+            int(scale_layout),
+            int(debug_stage),
+        )
+    return out
+
