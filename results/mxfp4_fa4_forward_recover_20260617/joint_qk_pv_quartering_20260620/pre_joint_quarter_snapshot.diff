+static void launch_mxfp4_tcgen_shape_debug(at::Tensor A_fp4,
+                                           at::Tensor A_sc,
+                                           at::Tensor B_fp4,
+                                           at::Tensor B_sc,
+                                           at::Tensor O,
+                                           int debug_stage) {
