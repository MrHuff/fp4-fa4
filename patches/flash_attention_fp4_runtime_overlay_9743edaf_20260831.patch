+@dsl_user_op
+def atomic_or_shared_u32(value, ptr, *, loc=None, ip=None) -> None:
+    """Atomically merge one or more packed FP4 nibbles into a shared word."""
+    nvvm.atomicrmw(
+        res=T.i32(),
+        op=nvvm.AtomicOpKind.OR,
+        ptr=ptr.llvm_ptr,
+        a=cutlass.Uint32(value).ir_value(loc=loc, ip=ip),
+    )
