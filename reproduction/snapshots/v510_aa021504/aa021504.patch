+                    wait(
+                        query_ready[next_stage],
+                        x32::input_stage_epoch_phase(next_work)
+                    );
+                    tensor_after_thread_sync();
+                    core::issue_score_or_dp(
+                        score_tmem,
+                        storage.k,
+                        storage.q[next_stage],
+                        score_ready
