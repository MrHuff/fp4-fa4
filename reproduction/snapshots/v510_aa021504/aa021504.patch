+                wait(ds_ready, phase);
+                tensor_after_thread_sync();
+                core::issue_gradient_atb(
+                    dq_tmem,
+                    storage.ds,
+                    storage.k,
+                    dq_ready
+                );
+                exact::issue_gradient_ab_runtime_accumulate(
+                    dk_tmem,
+                    storage.ds,
+                    storage.q[stage],
+                    dk_ready,
+                    work != 0
+                );
