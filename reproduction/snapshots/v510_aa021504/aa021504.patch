+            compact.words[second_word],
+            dp,
+            storage.dstat[input_stage],
+            query_column_base,
+            second_word,
+            beta
+        );
+        const int column = lane_column_base + 4 * first_word;
+        const uint32_t destination_address = destination.idx(
+            shared_address,
+            {lane_row, column}
+        );
+        asm volatile(
+            "st.shared.v2.b32 [%0], {%1, %2};\n"
