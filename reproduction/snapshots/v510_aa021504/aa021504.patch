+            }
+        }
+
+        const int last_phase =
+            x32::iteration_phase(total_work - 1);
+        wait(dk_ready, last_phase);
+        tensor_after_thread_sync();
+        prior::wait_full_gradient_reuse(
+            full_gradient_reusable,
+            x32::iteration_phase(total_work - 1),
+            logical_warp,
