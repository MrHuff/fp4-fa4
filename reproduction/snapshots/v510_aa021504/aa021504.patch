+        prior::drain_gradient_full_owner_x32(
+            dv_tmem,
+            storage.gradient,
+            full_gradient_ready,
+            logical_warp,
+            lane
+        );
+        prior::publish_gradient_full(
+            g.dv,
+            storage.gradient,
+            full_gradient_ready,
+            1,
+            batch,
+            key_tile,
+            kv_head,
+            logical_warp,
