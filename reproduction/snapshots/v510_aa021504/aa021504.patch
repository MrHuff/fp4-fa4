+__device__ __forceinline__ float4 expand_compact_e4m3_word(
+    uint32_t packed
+) {
+    const fp8e4m3_4 probability = std::bit_cast<fp8e4m3_4>(packed);
+    return kittens::base_types::convertor<float4, fp8e4m3_4>::convert(
+        probability
+    );
+}
