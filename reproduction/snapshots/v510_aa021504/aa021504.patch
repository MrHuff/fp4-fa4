+            q.size(1)
+        ),
+        kittens::py::tensor_to_gl<globals::stats_gl>(
+            dstat,
+            q.size(0),
+            q.size(2),
+            1,
+            q.size(1)
+        ),
+        beta,
+        beta * kLog2E,
+        static_cast<int>(q.size(1)),
+    };
+}
