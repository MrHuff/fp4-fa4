+    uint32_t final_values[prior::kDepthChunk];
+    x32::load_tmem_owner_x32(
+        values,
+        source_row + kPairedDepthChunk * prior::kDepthChunk
+    );
+    x32::load_tmem_owner_x32(
+        final_values,
+        source_row + kFinalDepthChunk * prior::kDepthChunk
+    );
+    tensor_load_wait();
