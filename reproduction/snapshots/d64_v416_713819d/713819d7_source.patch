+constexpr int kColumnHalf = half::kColumnHalf;
+constexpr int kThreads = predecessor::kThreads;
+constexpr int kComputeWarps = predecessor::kComputeWarps;
+constexpr int kReduceWarpBase = predecessor::kReduceWarpBase;
