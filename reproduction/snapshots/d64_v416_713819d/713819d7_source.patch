+// probability lifetime, owner-aligned publications, and dQ-first tensor-issue
+// schedule remain unchanged.  Only the tensor descriptors/coordinates change
+// from contiguous BHSD to contiguous BSHD, and the already-prelifted forward
+// statistics are consumed directly: lstat = 8-LSE*log2(e) and
+// dstat = -16*sum(O*dO).
+namespace tkfa4::native_gqa_tk_bwd::v416_d64_gqa_e4m3_production_bshd_dq_first_vec2_ds {
