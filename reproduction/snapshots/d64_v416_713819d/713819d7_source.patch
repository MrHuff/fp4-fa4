+            dstat,
+            q.size(0),
+            q.size(2),
+            1,
+            q.size(1)
+        ),
+        beta,
+        beta * kLog2E,
+        1.0f,
+        static_cast<int>(q.size(1)),
+    };
+    const dim3 grid(
+        static_cast<unsigned int>(q.size(1) / kKeyTile),
+        static_cast<unsigned int>(q.size(2)),
+        static_cast<unsigned int>(q.size(0))
