+// Bounded full-P experiment on the safe 512-thread topology.  Native EX2
+// still forms FP32 P and the original FP32 values publish the E4M3 TMEM
+// payload for dV.  Only the longer-lived dS multiplier is rounded to packed
+// FP16 after publication, cutting its residency from 64 to 32 registers per
+// lane.  dP stays FP32 in two exact 16-value owner chunks, and v406's dQ-first
+// tensor-issue order is retained.
+namespace tkfa4::native_gqa_tk_bwd::v410_d64_gqa_e4m3_owner_packed_fp16_full_p_dq_first {
+
+namespace base =
+    tkfa4::native_gqa_tk_bwd::v385_d64_gqa_e4m3_k128q128;
