GPU := B200
.DEFAULT_GOAL := all
SRC := v509_d128_gqa_nvfp4_score_e4m3_qkv_e5m2_dout_b1_exact_s4096_experimental_bshd.cu
BUILD_DIR ?= /tmp/tk_fa4/native_score_v509/build
EXT_SUFFIX := $(shell python3 -c "import sysconfig; print(sysconfig.get_config_var('EXT_SUFFIX'))")
MODULE := _C_sm100_gqa_tk_v509_d128_nvfp4_score_e4m3_qkv_e5m2_dout_b1_s4096
OUT := $(BUILD_DIR)/$(MODULE)$(EXT_SUFFIX)
CMD := python3 -c "import importlib.util; p='$(OUT)'; s=importlib.util.spec_from_file_location('$(MODULE)', p); m=importlib.util.module_from_spec(s); s.loader.exec_module(m); print(m.native_tk_d128_backward_metadata())"
CONFIG := pytorch
override EXTRA_NVCCFLAGS += -DTORCH_COMPILE
override EXTRA_NVCCFLAGS += -DTKFA4_V509_EXACT_BATCH=1
override EXTRA_NVCCFLAGS += -I$(CURDIR)

HEADERS := \
	v509_d128_gqa_nvfp4_score_e4m3_qkv_e5m2_dout_b1_exact_s4096_experimental_bshd.cuh \
	e5m2_dout_mixed_mma_microgate_20260831.cuh \
	v438_d128_gqa_e4m3_b2_owner2_exact_s4096_production_bshd.cuh \
	v436_d128_gqa_e4m3_exact_s4096_runtime_accumulate_production_bshd.cuh \
	v437_d128_gqa_e4m3_b2_owner2_production_bshd.cuh \
	v433_d128_gqa_e4m3_head_fast_raster_production_bshd.cuh \
	v431_d128_gqa_e4m3_bf16_dq_evacuation_production_bshd.cuh \
	v429_d128_gqa_e4m3_owner_x32_gradient_publication_production_bshd.cuh \
	v421_d128_gqa_e4m3_async_production_bshd.cuh \
	v420_d128_gqa_e4m3_shared_p_production_bshd.cuh \
	v416_d64_gqa_e4m3_production_bshd_dq_first_vec2_ds.cuh \
	v387_d64_gqa_e4m3_async_pipeline.cuh \
	v386_d64_gqa_e4m3_k128q128_halfcols.cuh \
	v385_d64_gqa_e4m3_k128q128.cuh \
	native_gqa_tk_bwd_pipelined.cuh \
	../deprecated/fa4_common.cuh

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

$(OUT): $(HEADERS) | $(BUILD_DIR)

include ../../ThunderKittens/kernels/common.mk

override NVCCFLAGS += -UTORCH_EXTENSION_NAME
override NVCCFLAGS += -DTORCH_EXTENSION_NAME=$(MODULE)
