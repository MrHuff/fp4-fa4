OUT := $(BUILD_DIR)/$(MODULE)$(EXT_SUFFIX)
CMD := python3 -c "import importlib.util; p='$(OUT)'; s=importlib.util.spec_from_file_location('$(MODULE)', p); m=importlib.util.module_from_spec(s); s.loader.exec_module(m); print(m.native_tk_d128_backward_metadata())"
CONFIG := pytorch
NVCCFLAGS += -DTORCH_COMPILE
NVCCFLAGS += -I$(CURDIR)

HEADERS := \
	v469_d128_gqa_e4m3_b2_s4096_owner4_dk_commit_gated_ds_reuse_production_bshd.cuh \
