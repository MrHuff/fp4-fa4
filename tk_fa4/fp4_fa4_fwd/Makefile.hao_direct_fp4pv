# Multiple policy-specialized extensions export the same C++ helper symbols.
# Bind calls to the definitions in the current shared object so importing a
# second policy cannot silently redirect the first policy's dispatch path.
HAO_EXTENSION_SYMBOLIC_BIND ?= 1
# CUDA registers template kernels by their mangled C++ name.  When several
# coefficient-specialized extensions are loaded together, -Bsymbolic isolates
# host helpers but cannot distinguish identical device template names.  Give
# routed policies a unique config type without changing their generated math.
HAO_KERNEL_SYMBOL_TAG ?=
# A single device-code partition gives ptxas enough whole-kernel visibility
# to hoist constants in the long S4096+ pipeline. S1024/S2048 release builds
# should override this with NVCC_SPLIT_COMPILE=2.
NVCC_SPLIT_COMPILE ?= 1
