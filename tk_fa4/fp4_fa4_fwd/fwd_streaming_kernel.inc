        event == FP4PV_FWD_TL_STAGE2_SCORE_WAIT_DONE ||
        event == FP4PV_FWD_TL_STAGE2_SCORE_TMEM_LOAD_DONE ||
        event == FP4PV_FWD_TL_STAGE2_SCORE_COPY_RELEASE ||
        event == FP4PV_FWD_TL_STAGE2_P_STAGE_REUSE_WAIT_BEGIN ||
        event == FP4PV_FWD_TL_STAGE2_P_STAGE_REUSE_WAIT_DONE ||
        event == FP4PV_FWD_TL_STAGE2_P_READY ||
        event == FP4PV_FWD_TL_STAGE2_SCORE_TMEM_LOAD_BEGIN ||
        event == FP4PV_FWD_TL_STAGE2_CAUSAL_MASK_DONE ||
        event == FP4PV_FWD_TL_STAGE2_P_MAX_DONE ||
        event == FP4PV_FWD_TL_STAGE2_P_SCALE_DERIVED_DONE ||
        event == FP4PV_FWD_TL_STAGE2_P_EXP_WEIGHT_DONE ||
        event == FP4PV_FWD_TL_STAGE2_P_PAYLOAD_PACK_DONE ||
        event == FP4PV_FWD_TL_STAGE2_P_ROW_SUM_CORR_DONE ||
        event == FP4PV_FWD_TL_STAGE2_P_SCALE_TMEM_DONE ||
        event == FP4PV_FWD_TL_STAGE2_P_PAYLOAD_PUBLISH_DONE ||
        event == FP4PV_FWD_TL_P_WAIT_BEGIN ||
        event == FP4PV_FWD_TL_P_PACK_READY ||
        event == FP4PV_FWD_TL_V_WAIT_BEGIN ||
        event == FP4PV_FWD_TL_V_SCALE_READY) {
        return tid == 256 ? 0 : -1;
    }
    if (event == FP4PV_FWD_TL_QK_SCORE_COPY_WAIT_BEGIN ||
        event == FP4PV_FWD_TL_QK_SCORE_COPY_WAIT_DONE) {
        if (tid != 256) {
            return -1;
        }
        if (p_buf == 0 || p_buf == 1) {
            return p_buf;
        }
        return 0;
    }
    if (event == FP4PV_FWD_TL_PV_ISSUE ||
        event == FP4PV_FWD_TL_PV_COMMIT ||
        event == FP4PV_FWD_TL_LIFECYCLE_ITER_PREPARED ||
        event == FP4PV_FWD_TL_LIFECYCLE_PV_ISSUE_BEGIN ||
        event == FP4PV_FWD_TL_LIFECYCLE_PV_ISSUE_DONE ||
        event == FP4PV_FWD_TL_LIFETABLE_ITER_PREPARE ||
        event == FP4PV_FWD_TL_LIFETABLE_PV_ISSUE_BEGIN ||
        event == FP4PV_FWD_TL_TWOID_OWNER_PV_PREPARED ||
        event == FP4PV_FWD_TL_TWOID_OWNER_PV_ISSUED) {
        return tid == 288 ? 1 : -1;
    }
    if (event == FP4PV_FWD_TL_PV_WAIT_BEGIN ||
        event == FP4PV_FWD_TL_PV_WAIT_DONE) {
        if (tid == 0) {
            return 2;
        }
        return tid == 288 ? 1 : -1;
    }
    if (event == FP4PV_FWD_TL_TILE_WAIT_BEGIN ||
        event == FP4PV_FWD_TL_TILE_WAIT_DONE ||
        event == FP4PV_FWD_TL_EPILOGUE_START ||
        event == FP4PV_FWD_TL_EPILOGUE_END) {
        return tid == 0 ? 2 : -1;
    }
    if (event == FP4PV_FWD_TL_HOTPLATE_SLOT_RELEASE ||
        event == FP4PV_FWD_TL_QK_EARLY_SCORE_UNUSED ||
        event == FP4PV_FWD_TL_QK_SOURCE_SCORE_UNUSED ||
        event == FP4PV_FWD_TL_QK_RELEASE_EPOCH_SET ||
        event == FP4PV_FWD_TL_EARLY_RELEASE_LATCH ||
        event == FP4PV_FWD_TL_EARLY_RELEASE_CANDIDATE ||
        event == FP4PV_FWD_TL_EARLY_RELEASE_INVALID ||
        event == FP4PV_FWD_TL_MIDDLE_RELEASE_CONFIRMED ||
        event == FP4PV_FWD_TL_MIDDLE_RELEASE_CONFIRM_MISS ||
        event == FP4PV_FWD_TL_LIFECYCLE_SCORE_COPY_DONE ||
        event == FP4PV_FWD_TL_LIFECYCLE_SCORE_SLOT_RELEASED ||
        event == FP4PV_FWD_TL_LIFETABLE_SCORE_COPY_DONE ||
        event == FP4PV_FWD_TL_LIFETABLE_SCORE_SLOT_RELEASED ||
        event == FP4PV_FWD_TL_LIFETABLE_RETIRE ||
        event == FP4PV_FWD_TL_TWOID_OWNER_SCORE_COPY_DONE ||
        event == FP4PV_FWD_TL_TWOID_OWNER_RELEASED ||
        event == FP4PV_FWD_TL_TWOID_RELEASE_WITH_CANDIDATE ||
        event == FP4PV_FWD_TL_TWOID_RELEASE_WITHOUT_CANDIDATE ||
        event == FP4PV_FWD_TL_TWOID_CANDIDATE_RELEASE_AFTER_HANDOFF) {
        if ((tid & 31) != 0) {
            return -1;
        }
        if (p_buf == 0 || p_buf == 1) {
            return p_buf;
        }
        return 3;
    }
    if (event == FP4PV_FWD_TL_LIFETABLE_OCCUPANCY ||
        event == FP4PV_FWD_TL_LIFETABLE_OVERWRITE_HAZARD ||
        event == FP4PV_FWD_TL_LIFETABLE_SAME_SCORE_SLOT_HAZARD ||
        event == FP4PV_FWD_TL_TWOID_OWNER_CANDIDATE_COEXIST ||
        event == FP4PV_FWD_TL_TWOID_OWNER_IDENTITY_MISMATCH) {
        if (tid == 256) {
            return 0;
        }
        if (tid == 288) {
            return 1;
        }
        if ((tid & 31) == 0) {
            return 3;
        }
        return -1;
    }
    return -1;
}

__device__ __forceinline__ void fp4pv_forward_timeline_record(
    unsigned long long event,
    int cur_bid,
    int task_num,
    int3 t_coord,
    int idx,
    int p_buf,
    int v_buf,
    int cta_rank,
    int role,
    int extra) {
    if (task_num < 0 ||
        static_cast<int>(blockIdx.x) >= TK_FA4_MXFP4_FWD_TIMELINE_SAMPLE_BLOCKS ||
        task_num >= TK_FA4_MXFP4_FWD_TIMELINE_SAMPLE_TASKS) {
        return;
    }
    if (event == 0 || event > static_cast<unsigned long long>(FP4PV_FWD_TIMELINE_EVENT_COUNT)) {
        return;
    }
    const int lane_slot = fp4pv_forward_timeline_lane_slot(event, p_buf);
    if (lane_slot < 0) {
        return;
    }
    const int norm_idx = fp4pv_forward_timeline_normalize_idx(idx);
    const unsigned long long rec =
        ((event - 1ULL) * static_cast<unsigned long long>(FP4PV_FWD_TIMELINE_INDEX_SLOTS) +
         static_cast<unsigned long long>(norm_idx)) *
            static_cast<unsigned long long>(FP4PV_FWD_TIMELINE_LANE_SLOTS) +
        static_cast<unsigned long long>(lane_slot);
    unsigned long long *dst =
        &fp4pv_forward_timeline[rec * FP4PV_FWD_TIMELINE_RECORD_U64];
    dst[0] = clock64();
    dst[2] =
        fp4pv_forward_timeline_pack_i32(static_cast<int>(blockIdx.x)) |
        (fp4pv_forward_timeline_pack_i32(static_cast<int>(gridDim.x)) << 32);
    dst[3] =
        fp4pv_forward_timeline_pack_i32(cur_bid) |
        (fp4pv_forward_timeline_pack_i32(task_num) << 32);
    dst[4] =
        (fp4pv_forward_timeline_pack_i32(t_coord.x) & 0xffffULL) |
        ((fp4pv_forward_timeline_pack_i32(t_coord.y) & 0xffffULL) << 16) |
        ((fp4pv_forward_timeline_pack_i32(t_coord.z) & 0xffffULL) << 32) |
        ((fp4pv_forward_timeline_pack_i32(cta_rank) & 0xffffULL) << 48);
    dst[5] =
        (fp4pv_forward_timeline_pack_i32(idx) & 0xffffULL) |
        ((fp4pv_forward_timeline_pack_i32(p_buf) & 0xffffULL) << 16) |
        ((fp4pv_forward_timeline_pack_i32(v_buf) & 0xffffULL) << 32) |
        ((fp4pv_forward_timeline_pack_i32(extra) & 0xffffULL) << 48);
    dst[6] =
        fp4pv_forward_timeline_pack_i32(static_cast<int>(threadIdx.x)) |
        ((fp4pv_forward_timeline_pack_i32(role) & 0xffffULL) << 32) |
        ((fp4pv_forward_timeline_pack_i32(warpgroup::warpid()) & 0xffffULL) << 48);
    dst[7] = static_cast<unsigned long long>(rec);
    dst[1] = event;
}
#define FP4PV_FWD_TIMELINE_RECORD(...) fp4pv_forward_timeline_record(__VA_ARGS__)
#define FP4PV_FWD_TIMELINE_RECORD_ACTIVE(...) do { if constexpr (MXFP4_PV && ONLINE) { FP4PV_FWD_TIMELINE_RECORD(__VA_ARGS__); FP4PV_FWD_Q4_LARGE_RECORD(__VA_ARGS__); } } while (0)
#else
#define FP4PV_FWD_TIMELINE_RECORD(...) do { } while (0)
#define FP4PV_FWD_TIMELINE_RECORD_ACTIVE(...) FP4PV_FWD_Q4_LARGE_RECORD(__VA_ARGS__)
#endif

