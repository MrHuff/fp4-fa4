                    fp4pv_publish_cta_shared_only();
                    warpgroup::arrive(p_online_split_max_ready[buf]);
                    if (!split_half_active) {
                        continue;
                    }

                    if constexpr (STATIC_ONLINE_MXFP4_LOCALMAX_SPLIT_P_QUANT_2WG) {
                        const bool local_has_scores = isfinite(local_tile_max);
                        float2 tile_sum0 = {0.0f, 0.0f};
                        float2 tile_sum1 = {0.0f, 0.0f};
                        if (!ZERO_SCALE && local_has_scores) {
                            const float neg_local_max_scaled = local_tile_max * (-SCALE_LOG2);
                            const float2 neg_local_max_scaled_2 = {neg_local_max_scaled, neg_local_max_scaled};
                            const float2 scale_2 = {SCALE_LOG2, SCALE_LOG2};
                            #pragma unroll
                            for (int qlocal = 0; qlocal < 2; ++qlocal) {
                                const int qid = p_half * 2 + qlocal;
                                uint32_t online_fixed_p_words[4];
                                #pragma unroll
                                for (int pack = 0; pack < 4; ++pack) {
                                    #pragma unroll
                                    for (int kk = 0; kk < 4; ++kk) {
