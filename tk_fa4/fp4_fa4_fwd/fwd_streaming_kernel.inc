};

__device__ unsigned long long fp4pv_kmc_passive_records[
    FP4PV_KMC_PASSIVE_MAX_TASKS * FP4PV_KMC_PASSIVE_FIELDS];

template <typename C>
__device__ __forceinline__ void fp4pv_kmc_passive_store(
    int task_id,
    int role,
    int event,
    int iter,
    int k_slot,
    int k_sc_slot,
    int k_phase,
    int k_sc_phase,
    int cta_rank) {
    if constexpr (fp4pv_online_rowpar2_k_multicast_passive<C>::value) {
        if (task_id >= 0 && task_id < FP4PV_KMC_PASSIVE_MAX_TASKS &&
            iter >= 0 && iter < FP4PV_KMC_PASSIVE_MAX_ITERS &&
            event >= 0 && event < FP4PV_KMC_PASSIVE_EVENT_COUNT) {
            const unsigned long long encoded =
                (1ULL << 63) |
                (static_cast<unsigned long long>(role & 0xf) << 59) |
                (static_cast<unsigned long long>(event & 0xf) << 55) |
                (static_cast<unsigned long long>(blockIdx.x & 0xffff) << 39) |
                (static_cast<unsigned long long>(cta_rank & 0x1) << 38) |
                (static_cast<unsigned long long>(iter & 0x3f) << 32) |
                (static_cast<unsigned long long>(k_slot & 0xf) << 28) |
                (static_cast<unsigned long long>(k_sc_slot & 0xf) << 24) |
                (static_cast<unsigned long long>(k_phase & 0x1) << 23) |
                (static_cast<unsigned long long>(k_sc_phase & 0x1) << 22) |
                static_cast<unsigned long long>(task_id & 0x3fffff);
            fp4pv_kmc_passive_records[
                task_id * FP4PV_KMC_PASSIVE_FIELDS +
                iter * FP4PV_KMC_PASSIVE_EVENT_COUNT + event] = encoded;
        }
    }
}
