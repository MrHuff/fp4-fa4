__device__ int fp4pv_real_fwd_corr_pv_cycle_target_bid;
__device__ int fp4pv_real_fwd_corr_pv_cycle_target_task_bid;

__device__ __forceinline__ int fp4pv_real_fwd_corr_pv_sample_slot(
    int idx, int iters) {
    if (idx == 0) return 0;
    if (idx == 1) return 1;
    if (idx == iters / 4 - 1) return 2;
    if (idx == iters / 4) return 3;
    if (idx == iters / 2 - 1) return 4;
    if (idx == iters / 2) return 5;
    if (idx == iters - 2) return 6;
    if (idx == iters - 1) return 7;
    return -1;
}

__device__ __forceinline__ int fp4pv_real_fwd_corr_pv_sample_idx(
    int sample, int iters) {
    if (sample == 0) return 0;
    if (sample == 1) return 1;
    if (sample == 2) return iters / 4 - 1;
    if (sample == 3) return iters / 4;
    if (sample == 4) return iters / 2 - 1;
    if (sample == 5) return iters / 2;
    if (sample == 6) return iters - 2;
    return iters - 1;
}

__device__ __forceinline__ int fp4pv_real_fwd_corr_pv_owner_tid(int event) {
    if (event == FP4PV_RF_CP_CORR_PUBLISHED_W0 ||
        event == FP4PV_RF_CP_SCORE_RELEASE) {
        return 128;
    }
    if (event == FP4PV_RF_CP_CORR_PUBLISHED_W1) return 160;
    if (event == FP4PV_RF_CP_CORR_PUBLISHED_W2) return 192;
    if (event == FP4PV_RF_CP_CORR_PUBLISHED_W3) return 224;
    if (event == FP4PV_RF_CP_PV_ISSUE ||
        event == FP4PV_RF_CP_PV_COMMIT ||
        event == FP4PV_RF_CP_P_STAGE_RELEASE) {
        return 288;
    }
    return 0;
}

template <typename C>
__device__ __forceinline__ void fp4pv_real_fwd_corr_pv_cycle_record(
    ulonglong2 *stage_records, int event, int idx, int iters, int task_bid,
    int slot, int phase,
    unsigned long long extra = 0ULL) {
    if constexpr (fp4pv_real_fwd_corr_pv_cycle_diag<C>::value) {
        constexpr int QUANT_MASK = 1;
        constexpr int ISSUE_MASK = 2;
        constexpr int OUTPUT_MASK = 4;
        const int required_mask =
            ((event >= FP4PV_RF_CP_CORR_PUBLISHED_W0 &&
              event <= FP4PV_RF_CP_CORR_PUBLISHED_W3) ||
             event == FP4PV_RF_CP_SCORE_RELEASE)
                ? QUANT_MASK
                : ((event == FP4PV_RF_CP_PV_ISSUE ||
                    event == FP4PV_RF_CP_PV_COMMIT ||
                    event == FP4PV_RF_CP_P_STAGE_RELEASE)
                       ? ISSUE_MASK
                       : OUTPUT_MASK);
        if ((fp4pv_real_fwd_corr_pv_cycle_mask<C>::value & required_mask) ==
            0) {
            return;
        }
        if (static_cast<int>(blockIdx.x) !=
                fp4pv_real_fwd_corr_pv_cycle_target_bid ||
            task_bid != fp4pv_real_fwd_corr_pv_cycle_target_task_bid ||
            event < 0 || event >= FP4PV_RF_CP_EVENT_COUNT) {
            return;
        }
        const int sample = fp4pv_real_fwd_corr_pv_sample_slot(idx, iters);
        if (sample < 0) {
            return;
        }
        const int record_index =
            sample * FP4PV_RF_CP_EVENT_COUNT + event;
        const unsigned long long packed_owner_meta =
            (static_cast<unsigned long long>(threadIdx.x) & 0xffffULL) |
            ((static_cast<unsigned long long>(slot) & 0xffffULL) << 16) |
            ((static_cast<unsigned long long>(phase) & 0xffULL) << 32) |
            (extra << 40);
        // The hot path writes shared memory only.  Each event owner emits its
        // own global records after its entire role/task loop, so diagnostic
        // stores cannot delay a corr/rescale/PV edge or persistent next task.
        asm volatile("" ::: "memory");
        const unsigned long long timestamp = clock64();
        stage_records[record_index] =
            make_ulonglong2(timestamp, packed_owner_meta);
        asm volatile("" ::: "memory");
    }
}

template <int READS, typename C>
__device__ __forceinline__ void fp4pv_real_fwd_corr_pv_cycle_balance_delay(
    int idx, int iters, int task_bid) {
    if constexpr (fp4pv_real_fwd_corr_pv_cycle_balance_pad<C>::value) {
        if (static_cast<int>(blockIdx.x) !=
                fp4pv_real_fwd_corr_pv_cycle_target_bid ||
            task_bid != fp4pv_real_fwd_corr_pv_cycle_target_task_bid ||
            fp4pv_real_fwd_corr_pv_sample_slot(idx, iters) < 0) {
            return;
        }
        unsigned long long clocks = 0ULL;
        #pragma unroll
        for (int read = 0; read < READS; ++read) {
            clocks ^= clock64() + static_cast<unsigned long long>(read + 1);
        }
        asm volatile("" : "+l"(clocks) :: "memory");
    }
}

__device__ __forceinline__ void fp4pv_real_fwd_corr_pv_cycle_clear_one(
    ulonglong2 *stage_records, int sample, int event) {
    const int record_index =
        sample * FP4PV_RF_CP_EVENT_COUNT + event;
    stage_records[record_index] = make_ulonglong2(0ULL, 0ULL);
}

template <typename C>
__device__ __forceinline__ void fp4pv_real_fwd_corr_pv_cycle_flush_one(
    const ulonglong2 *stage_records, int sample, int event, int iters,
    int task_bid, int expected_owner_tid) {
    if constexpr (fp4pv_real_fwd_corr_pv_cycle_diag<C>::value) {
        const int record_index =
            sample * FP4PV_RF_CP_EVENT_COUNT + event;
        const ulonglong2 staged = stage_records[record_index];
        if (staged.x == 0ULL) {
            return;
        }
        const unsigned long long packed_owner_meta = staged.y;
        const unsigned long long owner_tid =
            packed_owner_meta & 0xffffULL;
        if (owner_tid !=
            (static_cast<unsigned long long>(expected_owner_tid) &
             0xffffULL)) {
            // Host validation requires every expected record.  Suppressing a
            // record on metadata mismatch is therefore a fail-closed error.
            return;
        }
        const int idx =
            fp4pv_real_fwd_corr_pv_sample_idx(sample, iters);
        const unsigned long long slot =
            (packed_owner_meta >> 16) & 0xffffULL;
        const unsigned long long phase =
            (packed_owner_meta >> 32) & 0xffULL;
        const unsigned long long extra = packed_owner_meta >> 40;
        unsigned long long *record =
            &fp4pv_real_fwd_corr_pv_cycle_records[
                record_index * FP4PV_RF_CP_RECORD_U64];
        const unsigned long long record_block =
            static_cast<unsigned long long>(blockIdx.x);
        const unsigned long long record_task =
            static_cast<unsigned long long>(task_bid);
        const unsigned long long record_owner_smid_idx_iters =
            owner_tid |
            ((static_cast<unsigned long long>(kittens::smid()) &
              0xffffULL) << 16) |
            ((static_cast<unsigned long long>(idx) & 0xffffULL) << 32) |
            ((static_cast<unsigned long long>(iters) & 0xffffULL) << 48);
        const unsigned long long record_slot_phase_extra =
            slot | (phase << 16) | (extra << 24);
        // Keep the complete tail-only publication in one PTX block.  The
        // timestamp is the validity word and must remain the last machine
        // store; an empty compiler barrier was insufficient because PTXAS
        // legally scheduled independent C++ stores around it.
        asm volatile(
            "st.global.u64 [%0+8], %1;\n\t"
            "st.global.u64 [%0+16], %2;\n\t"
            "st.global.u64 [%0+24], %3;\n\t"
            "st.global.u64 [%0+32], %4;\n\t"
            "st.release.gpu.global.u64 [%0], %5;\n\t"
            :
            : "l"(record), "l"(record_block), "l"(record_task),
              "l"(record_owner_smid_idx_iters),
              "l"(record_slot_phase_extra), "l"(staged.x)
            : "memory");
    }
}

template <typename C>
__device__ __forceinline__ bool fp4pv_real_fwd_corr_pv_flush_active(
    int task_bid, int expected_owner_tid) {
    if constexpr (!fp4pv_real_fwd_corr_pv_cycle_diag<C>::value) {
        return false;
    }
    return static_cast<int>(threadIdx.x) == expected_owner_tid &&
           static_cast<int>(blockIdx.x) ==
               fp4pv_real_fwd_corr_pv_cycle_target_bid &&
           task_bid == fp4pv_real_fwd_corr_pv_cycle_target_task_bid;
}

template <typename C>
__device__ __forceinline__ void fp4pv_real_fwd_corr_pv_cycle_flush_output(
    const ulonglong2 *stage_records, int iters, int task_bid) {
    constexpr int OWNER_TID = 0;
    if (!fp4pv_real_fwd_corr_pv_flush_active<C>(task_bid, OWNER_TID)) return;
    #pragma unroll 1
    for (int sample = 0; sample < FP4PV_RF_CP_SAMPLE_SLOTS; ++sample) {
        fp4pv_real_fwd_corr_pv_cycle_flush_one<C>(stage_records, sample, FP4PV_RF_CP_TASK_BEGIN, iters, task_bid, OWNER_TID);
        fp4pv_real_fwd_corr_pv_cycle_flush_one<C>(stage_records, sample, FP4PV_RF_CP_CORR_WAIT_BEGIN, iters, task_bid, OWNER_TID);
        fp4pv_real_fwd_corr_pv_cycle_flush_one<C>(stage_records, sample, FP4PV_RF_CP_CORR_READY, iters, task_bid, OWNER_TID);
        fp4pv_real_fwd_corr_pv_cycle_flush_one<C>(stage_records, sample, FP4PV_RF_CP_CORR_LOAD_BEGIN, iters, task_bid, OWNER_TID);
        fp4pv_real_fwd_corr_pv_cycle_flush_one<C>(stage_records, sample, FP4PV_RF_CP_CORR_LOAD_END, iters, task_bid, OWNER_TID);
        fp4pv_real_fwd_corr_pv_cycle_flush_one<C>(stage_records, sample, FP4PV_RF_CP_RESCALE_BEGIN, iters, task_bid, OWNER_TID);
        fp4pv_real_fwd_corr_pv_cycle_flush_one<C>(stage_records, sample, FP4PV_RF_CP_RESCALE_END, iters, task_bid, OWNER_TID);
        fp4pv_real_fwd_corr_pv_cycle_flush_one<C>(stage_records, sample, FP4PV_RF_CP_RESCALE_PUBLISHED, iters, task_bid, OWNER_TID);
        fp4pv_real_fwd_corr_pv_cycle_flush_one<C>(stage_records, sample, FP4PV_RF_CP_PV_WAIT_BEGIN, iters, task_bid, OWNER_TID);
        fp4pv_real_fwd_corr_pv_cycle_flush_one<C>(stage_records, sample, FP4PV_RF_CP_PV_READY, iters, task_bid, OWNER_TID);
        fp4pv_real_fwd_corr_pv_cycle_flush_one<C>(stage_records, sample, FP4PV_RF_CP_SCALE_RELEASE, iters, task_bid, OWNER_TID);
        fp4pv_real_fwd_corr_pv_cycle_flush_one<C>(stage_records, sample, FP4PV_RF_CP_TASK_END, iters, task_bid, OWNER_TID);
    }
}

template <typename C>
__device__ __forceinline__ void fp4pv_real_fwd_corr_pv_cycle_flush_issue(
    const ulonglong2 *stage_records, int iters, int task_bid) {
    constexpr int OWNER_TID = 288;
    if (!fp4pv_real_fwd_corr_pv_flush_active<C>(task_bid, OWNER_TID)) return;
    #pragma unroll 1
    for (int sample = 0; sample < FP4PV_RF_CP_SAMPLE_SLOTS; ++sample) {
        fp4pv_real_fwd_corr_pv_cycle_flush_one<C>(stage_records, sample, FP4PV_RF_CP_PV_ISSUE, iters, task_bid, OWNER_TID);
        fp4pv_real_fwd_corr_pv_cycle_flush_one<C>(stage_records, sample, FP4PV_RF_CP_PV_COMMIT, iters, task_bid, OWNER_TID);
        fp4pv_real_fwd_corr_pv_cycle_flush_one<C>(stage_records, sample, FP4PV_RF_CP_P_STAGE_RELEASE, iters, task_bid, OWNER_TID);
    }
}

template <typename C>
__device__ __forceinline__ void fp4pv_real_fwd_corr_pv_cycle_flush_quant(
    const ulonglong2 *stage_records, int iters, int task_bid) {
    const int owner_tid = static_cast<int>(threadIdx.x);
    int corr_event = -1;
    if (owner_tid == 128) corr_event = FP4PV_RF_CP_CORR_PUBLISHED_W0;
    else if (owner_tid == 160) corr_event = FP4PV_RF_CP_CORR_PUBLISHED_W1;
    else if (owner_tid == 192) corr_event = FP4PV_RF_CP_CORR_PUBLISHED_W2;
    else if (owner_tid == 224) corr_event = FP4PV_RF_CP_CORR_PUBLISHED_W3;
    else return;
    if (!fp4pv_real_fwd_corr_pv_flush_active<C>(task_bid, owner_tid)) return;
    #pragma unroll 1
    for (int sample = 0; sample < FP4PV_RF_CP_SAMPLE_SLOTS; ++sample) {
        fp4pv_real_fwd_corr_pv_cycle_flush_one<C>(stage_records, sample, corr_event, iters, task_bid, owner_tid);
        if (owner_tid == 128) {
            fp4pv_real_fwd_corr_pv_cycle_flush_one<C>(stage_records, sample, FP4PV_RF_CP_SCORE_RELEASE, iters, task_bid, owner_tid);
        }
    }
}

__device__ __forceinline__ void fp4pv_real_fwd_corr_pv_cycle_clear_owner(
    ulonglong2 *stage_records) {
    const int owner_tid = static_cast<int>(threadIdx.x);
    #pragma unroll 1
    for (int sample = 0; sample < FP4PV_RF_CP_SAMPLE_SLOTS; ++sample) {
        if (owner_tid == 0) {
            fp4pv_real_fwd_corr_pv_cycle_clear_one(stage_records, sample, FP4PV_RF_CP_TASK_BEGIN);
            fp4pv_real_fwd_corr_pv_cycle_clear_one(stage_records, sample, FP4PV_RF_CP_CORR_WAIT_BEGIN);
            fp4pv_real_fwd_corr_pv_cycle_clear_one(stage_records, sample, FP4PV_RF_CP_CORR_READY);
            fp4pv_real_fwd_corr_pv_cycle_clear_one(stage_records, sample, FP4PV_RF_CP_CORR_LOAD_BEGIN);
            fp4pv_real_fwd_corr_pv_cycle_clear_one(stage_records, sample, FP4PV_RF_CP_CORR_LOAD_END);
            fp4pv_real_fwd_corr_pv_cycle_clear_one(stage_records, sample, FP4PV_RF_CP_RESCALE_BEGIN);
            fp4pv_real_fwd_corr_pv_cycle_clear_one(stage_records, sample, FP4PV_RF_CP_RESCALE_END);
            fp4pv_real_fwd_corr_pv_cycle_clear_one(stage_records, sample, FP4PV_RF_CP_RESCALE_PUBLISHED);
            fp4pv_real_fwd_corr_pv_cycle_clear_one(stage_records, sample, FP4PV_RF_CP_PV_WAIT_BEGIN);
            fp4pv_real_fwd_corr_pv_cycle_clear_one(stage_records, sample, FP4PV_RF_CP_PV_READY);
            fp4pv_real_fwd_corr_pv_cycle_clear_one(stage_records, sample, FP4PV_RF_CP_SCALE_RELEASE);
            fp4pv_real_fwd_corr_pv_cycle_clear_one(stage_records, sample, FP4PV_RF_CP_TASK_END);
        } else if (owner_tid == 128) {
            fp4pv_real_fwd_corr_pv_cycle_clear_one(stage_records, sample, FP4PV_RF_CP_CORR_PUBLISHED_W0);
            fp4pv_real_fwd_corr_pv_cycle_clear_one(stage_records, sample, FP4PV_RF_CP_SCORE_RELEASE);
        } else if (owner_tid == 160) {
            fp4pv_real_fwd_corr_pv_cycle_clear_one(stage_records, sample, FP4PV_RF_CP_CORR_PUBLISHED_W1);
        } else if (owner_tid == 192) {
            fp4pv_real_fwd_corr_pv_cycle_clear_one(stage_records, sample, FP4PV_RF_CP_CORR_PUBLISHED_W2);
        } else if (owner_tid == 224) {
            fp4pv_real_fwd_corr_pv_cycle_clear_one(stage_records, sample, FP4PV_RF_CP_CORR_PUBLISHED_W3);
        } else if (owner_tid == 288) {
            fp4pv_real_fwd_corr_pv_cycle_clear_one(stage_records, sample, FP4PV_RF_CP_PV_ISSUE);
            fp4pv_real_fwd_corr_pv_cycle_clear_one(stage_records, sample, FP4PV_RF_CP_PV_COMMIT);
            fp4pv_real_fwd_corr_pv_cycle_clear_one(stage_records, sample, FP4PV_RF_CP_P_STAGE_RELEASE);
        }
    }
}

template <typename C>
__device__ __forceinline__ void fp4pv_real_fwd_timeline_record(
    int event, int idx, int task_bid, int slot, int phase, int extra = 0) {
    if constexpr (fp4pv_real_fwd_timeline_trace<C>::value) {
        if (static_cast<int>(blockIdx.x) !=
                fp4pv_real_fwd_timeline_target_bid ||
            idx < 0 || idx >= FP4PV_RF_MAX_TILES ||
            event < 0 || event >= FP4PV_RF_EVENT_COUNT) {
            return;
        }
        unsigned long long timestamp;
        asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(timestamp) :: "memory");
        volatile unsigned long long *record =
            &fp4pv_real_fwd_timeline_records[
                (idx * FP4PV_RF_EVENT_COUNT + event) * FP4PV_RF_RECORD_U64];
        record[1] = static_cast<unsigned long long>(blockIdx.x);
        record[2] = static_cast<unsigned long long>(task_bid);
        record[3] = static_cast<unsigned long long>(threadIdx.x);
        record[4] =
            (static_cast<unsigned long long>(slot) & 0xffffULL) |
            ((static_cast<unsigned long long>(phase) & 0xffULL) << 16) |
            ((static_cast<unsigned long long>(extra) & 0xffffffffULL) << 24);
        // The timestamp is the validity word and is intentionally published last.
        record[0] = timestamp;
    }
}
#else
// Generic forward-only builds still instantiate the production streaming
// templates, whose discarded cycle-diagnostic branches name these targets and
// the owner-clear helper.  Keep the disabled build symbol-free: constexpr
// sentinels satisfy non-dependent lookup, and the clear is a true no-op.
static constexpr int fp4pv_real_fwd_corr_pv_cycle_target_bid = -1;
static constexpr int fp4pv_real_fwd_corr_pv_cycle_target_task_bid = -1;
__device__ __forceinline__ void fp4pv_real_fwd_corr_pv_cycle_clear_owner(
    ulonglong2 *) {}

