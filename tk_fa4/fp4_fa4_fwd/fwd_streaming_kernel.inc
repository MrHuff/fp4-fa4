        } else if constexpr (STATIC_ONLINE_MXFP4_PERSISTENT_OUTER_CLC_SCHEDWARP &&
                             !STATIC_ONLINE_MXFP4_PERSISTENT_OUTER_CLC_STATIC_STRIDE) {
	            PersistouterQuantTaskInfo task = make_persistouter_quant_task_info(persistouter_clc_task_bid, 0);
            if (task.valid) {
                run_persistouter_quant_task_body(task);
                cluster_slot_lifetime_mark_done(
                    4, CLUSTER_SLOT_DOMAIN_P_PAYLOAD, task.cur_bid);
                cluster_slot_lifetime_mark_done(
                    5, CLUSTER_SLOT_DOMAIN_P_SCALE, task.cur_bid);
            }
        } else {
            int staticstride_quant_output_reuse_phase = 0;
            for (int cur_bid = blockIdx.x, task_num = 0; cur_bid < total_bids; cur_bid += gridDim.x, ++task_num) {
                if constexpr (STATIC_ONLINE_MXFP4_PERSISTENT_OUTER_CLC_STATIC_STRIDE) {
                    if (STATIC_ONLINE_MXFP4_PERSISTENT_OUTER_CLC_TASKDIAG_ALL_TASKS ||
                        task_num > 0) {
                        wait(output_reusable[0], staticstride_quant_output_reuse_phase);
                        staticstride_quant_output_reuse_phase ^= 1;
                    }
                }
	                PersistouterQuantTaskInfo task = make_persistouter_quant_task_info(cur_bid, task_num);
                if (!task.valid) {
                    continue;
                }
                run_persistouter_quant_task_body(task);
                cluster_slot_lifetime_mark_done(
                    4, CLUSTER_SLOT_DOMAIN_P_PAYLOAD, task.cur_bid);
                cluster_slot_lifetime_mark_done(
                    5, CLUSTER_SLOT_DOMAIN_P_SCALE, task.cur_bid);
            }
        }
	    if constexpr (fp4pv_real_fwd_corr_pv_cycle_diag<C>::value) {
	        if (quant_corr_pv_cycle_target_seen && warp::elect_leader()) {
	            fp4pv_real_fwd_corr_pv_cycle_flush_quant<C>(
	                corr_pv_cycle_stage,
	                quant_corr_pv_cycle_target_iters,
	                quant_corr_pv_cycle_target_bid_cache);
	        }
	    }
    } else if (warpgroup::groupid() == RELAY_WG) {
        if constexpr (STATIC_ONLINE_MXFP4_REG_TUNE && C::TOTAL_WGS == 4) {
            warpgroup::decrease_registers<STATIC_ONLINE_MXFP4_RELAY_REGS>();
        } else if constexpr (STATIC_SPLIT_P_QUANT) {
            warpgroup::decrease_registers<24>();
        }
        if constexpr (!STATIC_SPLIT_P_QUANT && !STATIC_ONLINE_MXFP4_DIRECT_P_READY) {
            int p_pack_phase_mask = 0;
            for (int cur_bid = blockIdx.x; cur_bid < total_bids; cur_bid += gridDim.x) {
                int3 t_coord = get_tile_idx(cur_bid);
                if constexpr (MXFP4_PV && EXTERNAL_COL_LSE) {
                    if (k_iter_end >= 0 && (t_coord.y < k_iter_begin || t_coord.y >= k_iter_end)) {
                        continue;
                    }
                }
                if (t_coord.y + cta_rank >= tiles_m) {
                    continue;
                }
                int iters_per_task = online_iters_for_row_cluster(t_coord.y);
                if constexpr (EXTERNAL_COL_LSE) {
                    iters_per_task = score_tiles_m - t_coord.y * SCORE_ITERS_PER_M_TILE;
                }
                for (int idx = 0; idx < iters_per_task; ++idx) {
                    const int buf = fp4pv_p_stage_buf_for_idx<P_STAGE_SLOTS>(idx);
                    const int p_pack_phase = (p_pack_phase_mask >> buf) & 1;
                    wait(p_pack_ready[buf], p_pack_phase);
                    p_pack_phase_mask ^= (1 << buf);
                    if constexpr (MXFP4_PV) {
                        publish_shared_backing();
                        tk_localcta::subgroup_barrier_sync<128>();
                    } else {
                        finalize_localcta_p_scales_with_amax<C>(p_sc_stage[buf], p_cta_amax[buf], warpgroup::laneid());
                    }
                    publish_cluster_shared_backing_if_needed<C>();
                    tk_localcta::subgroup_barrier_sync<128>();
                    if constexpr (C::CLUSTER_SIZE > 1) {
                        if (cta_rank == 1 && warpgroup::warpid() == 0 && warp::elect_leader()) {
                            tma::cluster::arrive(p_remote_ready[buf], 0);
                        }
                    }
                    warpgroup::arrive(p_quant_ready[buf]);
                }
            }
        }
    }
	if constexpr (STATIC_ONLINE_NATIVE_GROUP2_DOWNSTREAM_DIAG) {
	    const int3 downstream_exit_coord = get_tile_idx(blockIdx.x);
	    if (downstream_exit_coord.x == 0 &&
	        downstream_exit_coord.y == 2 &&
	        downstream_exit_coord.z == 0 &&
	        warpgroup::warpid() == 0 && warp::elect_leader()) {
	        // Reaching this edge proves the role body returned.  Tensor-allocator
	        // group2 teardown follows after kernel-scope destruction, so a full
	        // 3-bit mask with a hung launch isolates that collective teardown.
	        atomicOr(
	            &fp4pv_pairpsc_desc_diag[62 + cta_rank],
	            1ULL << static_cast<unsigned long long>(
	                32 + warpgroup::groupid()));
	        __threadfence_system();
	    }
	}
}
