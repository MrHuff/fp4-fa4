		                            }
		                            p_score_mx_e8m0[qlocal] = p_e8m0;
		                            p_score_mx_log2_coeff[qlocal] = (p_e8m0 == 0)
		                                ? 0.0f
		                                : (FP4PV_MXFP4_ONLINE_LOG2_6P_SCALE -
		                                   static_cast<float>(static_cast<int>(p_e8m0) - 127));
		                            p_score_mx_rcp_coeff[qlocal] =
		                                fp4pv_exp2f_e8m0(p_e8m0) *
		                                FP4PV_MXFP4_ONLINE_RCP_6P_SCALE;
		                            packed_half_scales |=
		                                static_cast<uint16_t>(p_e8m0) << (qlocal * 8);
	                        }
	                        p_online_split_scale_half[buf][p_half][global_row] =
	                            packed_half_scales;
	                        fp4pv_publish_cta_shared_only();
	                        warp::arrive(p_online_split_scale_ready[buf]);

		                        if (warpgroup::groupid() == QUANT_WG0) {
		                            const int scale_phase =
		                                (p_online_split_scale_phase_mask >> buf) & 1;
		                            wait(p_online_split_scale_ready[buf], scale_phase);
		                            p_online_split_scale_phase_mask ^= (1 << buf);
		                            const uint32_t row_scale_word = row_active
		                                ? (static_cast<uint32_t>(
		                                       p_online_split_scale_half[buf][0][global_row]) |
		                                   (static_cast<uint32_t>(
		                                        p_online_split_scale_half[buf][1][global_row]) << 16))
		                                : 0u;
		                            constexpr int P_SC_BASE =
		                                SCALE_TMEM_BASE + Q_SCALE_TMEM_WIDTH + K_SCALE_TMEM_WIDTH;
		                            static_assert(
		                                P_SC_BASE + P_SCALE_TMEM_SLOTS * P_SCALE_TMEM_WIDTH <=
		                                    MAX_TENSOR_COLS,
		                                "score-derived split-P scale slots exceed TMEM budget");
		                            d_tt_p_sc p_sc_tm0 =
		                                tm_alloc.template allocate<d_tt_p_sc>(P_SC_BASE);
		                            d_tt_p_sc p_sc_tm1 =
		                                tm_alloc.template allocate<d_tt_p_sc>(
		                                    P_SC_BASE + P_SCALE_TMEM_WIDTH);
		                            d_tt_p_sc p_sc_tm_cur = (idx & 1) == 0 ? p_sc_tm0 : p_sc_tm1;
		                            fp4pv_store_mxfp4_scale_tmem_32x32b_x1(
		                                p_sc_tm_cur, warpgroup::warpid(), row_scale_word);
		                            FP4PV_PCHAIN_QUANT_STAMP(6, idx, quant_diag_cur_bid);

	                        if constexpr (STATIC_ONLINE_MXFP4_EARLY_P_READY ||
                                                  STATIC_ONLINE_MXFP4_PAIR_P_STAGE_P_SCALE_LIFETIME) {
	                                if (corr_reuse_ready_count >= STATIC_ONLINE_MXFP4_CORR_SLOTS) {
	                                    const int reuse_phase =
	                                        (corr_reuse_phase_mask >> corr_slot) & 1;
	                                    wait(rescale_finished[corr_slot], reuse_phase);
	                                    corr_reuse_phase_mask ^= (1 << corr_slot);
	                                }
	                            }
	                            stats_store(
	                                corr_vec_smem[corr_slot], warpgroup::laneid(), acc_scale);
	                            warp::sync();
	                            warp::arrive(corr_arrived[corr_slot]);
	                            if constexpr (STATIC_ONLINE_MXFP4_EARLY_P_READY ||
	                                          STATIC_ONLINE_MXFP4_PAIR_P_STAGE_P_SCALE_LIFETIME) {
	                                ++corr_reuse_ready_count;
	                            }
	                        }

		                        float tile_sum_scalar_prescaled_dynamic = 0.0f;
		                        auto produce_half = [&](auto half_tag) {
		                            constexpr int HALF = decltype(half_tag)::value;
		                            fp4pv_stage2_static_for<0, 2>([&](auto qlocal_tag) {
		                                constexpr int QLOCAL = decltype(qlocal_tag)::value;
		                                constexpr int QID = HALF * 2 + QLOCAL;
		                                uint32_t online_p_words[4];
		                                float2 tile_sum_q0 = {0.0f, 0.0f};
		                                float2 tile_sum_q1 = {0.0f, 0.0f};
		                                const uint8_t p_q_e8m0 = p_score_mx_e8m0[QLOCAL];
		                                const float p_q_log2_coeff =
		                                    p_score_mx_log2_coeff[QLOCAL];
		                                const float p_q_rcp_coeff =
		                                    p_score_mx_rcp_coeff[QLOCAL];
		                                const float2 scale_2 = {SCALE_LOG2, SCALE_LOG2};
		                                const float neg_max_scaled_q =
		                                    row_max * (-SCALE_LOG2) + p_q_log2_coeff;
		                                const float2 neg_max_scaled_2 = {
		                                    neg_max_scaled_q, neg_max_scaled_q};
		                                fp4pv_stage2_static_for<0, 4>([&](auto pack_tag) {
		                                    constexpr int PACK = decltype(pack_tag)::value;
		                                    fp4pv_stage2_static_for<0, 4>([&](auto kk_tag) {
		                                        constexpr int KK = decltype(kk_tag)::value;
		                                        constexpr int JJ = PACK * 4 + KK;
		                                        constexpr int SI = QLOCAL * 16 + JJ;
		                                        constexpr int PAIR_INDEX = QID * 16 + JJ;
		                                        if (!ZERO_SCALE) {
		                                            scores_half[SI] = __ffma2_rn(
		                                                scores_half[SI],
		                                                scale_2,
		                                                neg_max_scaled_2);
		                                        } else {
		                                            scores_half[SI].x = isfinite(scores_half[SI].x)
		                                                ? p_q_log2_coeff
		                                                : scores_half[SI].x;
		                                            scores_half[SI].y = isfinite(scores_half[SI].y)
		                                                ? p_q_log2_coeff
		                                                : scores_half[SI].y;
		                                        }
		                                        scores_half[SI] = fp4pv_stage2_exp2_pair<
		                                            STATIC_ONLINE_MXFP4_STAGE2_EX2_EMU_PERIOD,
		                                            STATIC_ONLINE_MXFP4_STAGE2_EX2_EMU_MASK,
		                                            PAIR_INDEX>(scores_half[SI]);
		                                        if constexpr ((JJ & 1) == 0) {
		                                            tile_sum_q0 =
		                                                __fadd2_rn(tile_sum_q0, scores_half[SI]);
		                                        } else {
		                                            tile_sum_q1 =
		                                                __fadd2_rn(tile_sum_q1, scores_half[SI]);
		                                        }
		                                    });
