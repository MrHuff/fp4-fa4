#define FP4PV_PROGRESSIVE_DIAG_MAX_BLOCKS 32
#define FP4PV_PROGRESSIVE_DIAG_ROLES 4
#define FP4PV_PROGRESSIVE_DIAG_MAX_EVENTS 64
#define FP4PV_PROGRESSIVE_DIAG_FIELDS 12
__device__ unsigned long long fp4pv_progressive_diag_counters[
    FP4PV_PROGRESSIVE_DIAG_MAX_BLOCKS * FP4PV_PROGRESSIVE_DIAG_ROLES];
__device__ unsigned long long fp4pv_progressive_diag_records[
    FP4PV_PROGRESSIVE_DIAG_MAX_BLOCKS * FP4PV_PROGRESSIVE_DIAG_ROLES *
    FP4PV_PROGRESSIVE_DIAG_MAX_EVENTS * FP4PV_PROGRESSIVE_DIAG_FIELDS];

__device__ __forceinline__ void fp4pv_progressive_diag_event(
    int role, int task_id, int task_num, int code, int iter, int slot,
    int phase, unsigned long long sem_state, int last_edge, int status) {
    if (blockIdx.x >= FP4PV_PROGRESSIVE_DIAG_MAX_BLOCKS || role < 0 ||
        role >= FP4PV_PROGRESSIVE_DIAG_ROLES) {
        return;
    }
    const int counter_idx =
        static_cast<int>(blockIdx.x) * FP4PV_PROGRESSIVE_DIAG_ROLES + role;
    const unsigned long long sequence =
        atomicAdd(&fp4pv_progressive_diag_counters[counter_idx], 1ULL);
    const int event = static_cast<int>(
        sequence < FP4PV_PROGRESSIVE_DIAG_MAX_EVENTS
            ? sequence
            : FP4PV_PROGRESSIVE_DIAG_MAX_EVENTS - 1);
    const int base =
        (counter_idx * FP4PV_PROGRESSIVE_DIAG_MAX_EVENTS + event) *
        FP4PV_PROGRESSIVE_DIAG_FIELDS;
    fp4pv_progressive_diag_records[base + 0] = sequence;
    fp4pv_progressive_diag_records[base + 1] =
        static_cast<unsigned long long>(status);
    fp4pv_progressive_diag_records[base + 2] =
        static_cast<unsigned long long>(role);
    fp4pv_progressive_diag_records[base + 3] =
        static_cast<unsigned long long>(task_id);
    fp4pv_progressive_diag_records[base + 4] =
        static_cast<unsigned long long>(task_num);
    fp4pv_progressive_diag_records[base + 5] =
        static_cast<unsigned long long>(code);
    fp4pv_progressive_diag_records[base + 6] =
        static_cast<unsigned long long>(iter);
    fp4pv_progressive_diag_records[base + 7] =
        static_cast<unsigned long long>(slot);
    fp4pv_progressive_diag_records[base + 8] =
        static_cast<unsigned long long>(phase);
    fp4pv_progressive_diag_records[base + 9] = sem_state;
    fp4pv_progressive_diag_records[base + 10] =
        static_cast<unsigned long long>(last_edge);
    fp4pv_progressive_diag_records[base + 11] = clock64();
}

