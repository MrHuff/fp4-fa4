template <typename C, bool ONLINE, int STATIC_CONSUMER_MODE = -1, bool EXTERNAL_COL_LSE = false, bool MXFP4_PV = false>
__cluster_dims__(C::CLUSTER_SIZE, 1, 1)
__launch_bounds__(C::NUM_THREADS, fp4pv_online_dvo64_two_pass<C>::value ? 2 : 1)
__global__ void kernel_streaming_live_fp4pv(
    const __grid_constant__ std::conditional_t<
        MXFP4_PV,
        globals_fp4pv_mxfp4_dv<C, ONLINE>,
        globals_fp4pv<C, ONLINE || !FP4PV_DIAG_USE_DIRECT_ROW_UPDATE>
    > g,
    int consumer_mode,
    int k_iter_begin,
    int k_iter_end
) {
    using G = std::conditional_t<
        MXFP4_PV,
        globals_fp4pv_mxfp4_dv<C, ONLINE>,
        globals_fp4pv<C, ONLINE || !FP4PV_DIAG_USE_DIRECT_ROW_UPDATE>
    >;
#ifdef TK_FA4_FULLK_WAVE_PROBE_BUILD
    constexpr bool STATIC_Q4_LARGE_DIAG_ACTIVE =
        MXFP4_PV && ONLINE && fp4pv_online_deep_joint_ring<C>::value;
#else
    constexpr bool STATIC_Q4_LARGE_DIAG_ACTIVE = true;
#endif
    constexpr bool STATIC_DEEP_V_GRANT_SHARED_READY = [] {
        if constexpr (requires { C::ONLINE_DEEP_V_GRANT_SHARED_READY; }) {
            return C::ONLINE_DEEP_V_GRANT_SHARED_READY;
        }
        return false;
    }();
    constexpr bool STATIC_DEEP_V_GRANT_CP_ISSUED = [] {
        if constexpr (requires { C::ONLINE_DEEP_V_GRANT_CP_ISSUED; }) {
            return C::ONLINE_DEEP_V_GRANT_CP_ISSUED;
        }
        return false;
    }();
    static_assert(!(STATIC_DEEP_V_GRANT_SHARED_READY &&
                    STATIC_DEEP_V_GRANT_CP_ISSUED));
    constexpr bool STATIC_ONLINE_ROWPAR2_RANKLOCAL =
        MXFP4_PV && ONLINE && (!EXTERNAL_COL_LSE) &&
        fp4pv_online_rowpar2_ranklocal<C>::value;
    // Exact S4096/H64 K/V-only cluster discriminator.  Both CTA ranks keep
    // score, P/P-scale, PV, output, and epilogue ownership strictly local.
    constexpr bool STATIC_ONLINE_ROWPAR2_UNIFORM_PAIR_MAX_ITERS = [] {
        if constexpr (requires { C::ONLINE_ROWPAR2_UNIFORM_PAIR_MAX_ITERS; }) {
            return static_cast<bool>(C::ONLINE_ROWPAR2_UNIFORM_PAIR_MAX_ITERS);
        }
        return false;
    }();
    constexpr bool STATIC_ONLINE_ROWPAR2_CANONICAL_LOCAL_FASTPATH = [] {
        if constexpr (requires { C::ONLINE_ROWPAR2_CANONICAL_LOCAL_FASTPATH; }) {
            return static_cast<bool>(C::ONLINE_ROWPAR2_CANONICAL_LOCAL_FASTPATH);
        }
        return false;
    }();
    // The exact two-slot K/V-only discriminator keeps the V-owner generation
    // in scalar registers.  A runtime-indexed two-element array makes ptxas
    // materialize an otherwise unnecessary local stack frame.
