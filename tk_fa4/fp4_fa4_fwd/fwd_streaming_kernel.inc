		                        FP4PV_PCHAIN_SPLIT_QUANT_STAMP(
		                            25, 26, idx, quant_diag_cur_bid, p_half);
		                        FP4PV_PCHAIN_QUANT_STAMP(8, idx, quant_diag_cur_bid);
	                        fp4pv_publish_shared_backing_proxy_only();

		                        if (warpgroup::groupid() == QUANT_WG0) {
		                            fp4pv_tmem_store_wait();
		                            FP4PV_PCHAIN_QUANT_STAMP(
		                                7, idx, quant_diag_cur_bid);
		                            warp::arrive(p_sc_tmem_ready[idx & 1]);
	                            if (warpgroup::warpid() == 0 && warp::elect_leader()) {
	                                ++quant_p_scale_ready_count;
	                            }
		                        }
		                        FP4PV_PCHAIN_SPLIT_QUANT_STAMP(
		                            27, 28, idx, quant_diag_cur_bid, p_half);
		                        if constexpr (STATIC_ONLINE_MXFP4_SCORE_DERIVED_K64_HALF_READY) {
	                            warp::arrive(p_online_k64_ready[buf][p_half]);
	                        } else {
	                            warp::arrive(p_quant_ready[buf]);
		                        }
		                        row_sum = row_sum * acc_scale + tile_sum_scalar_prescaled_dynamic;
		                        continue;
		                    }
                    const int p_half = (C::Nb == 64 || warpgroup::groupid() == QUANT_WG0) ? 0 : 1;
                    const bool split_half_active = (C::Nb == 128) || (warpgroup::groupid() == QUANT_WG0);
                    float2 scores_half[32];
                    const uint32_t score_tt_base = wait_for_scores(idx);
                    if constexpr (STATIC_ONLINE_MXFP4_PERSISTENT_OUTER_CLC_TASKDIAG_NO_RESET) {
                        if (quant_diag_timeout) {
                            return;
                        }
                    }
                    if (split_half_active) {
                        fp4pv_load_score_half_tmem(scores_half, score_tt_base, p_half);
                        tensor_load_wait();
                    }
                    arrive_score_copy_done(idx, buf);
                    if (!wait_for_p_stage_reusable(idx, buf)) {
                        return;
                    }
                    if (split_half_active) {
                        fp4pv_apply_online_causal_mask_score_half<C>(scores_half, p_half, idx, m_tile);
                    }

                    float local_tile_max = base_types::constants<float>::neg_infty();
                    if (split_half_active) {
                        #pragma unroll
                        for (int jj = 0; jj < 32; ++jj) {
                            asm volatile("{max.f32 %0, %1, %2, %3;}"
                                : "=f"(local_tile_max)
                                : "f"(local_tile_max), "f"(scores_half[jj].x), "f"(scores_half[jj].y));
