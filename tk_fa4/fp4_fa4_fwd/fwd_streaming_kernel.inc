static constexpr int FP4PV_FWD_TIMELINE_RECORD_U64 = 8;
static constexpr int FP4PV_FWD_TIMELINE_EVENT_COUNT = 389;
static constexpr int FP4PV_FWD_TIMELINE_INDEX_SLOTS = 64;
static constexpr int FP4PV_FWD_TIMELINE_LANE_SLOTS = 4;
static constexpr int FP4PV_FWD_TIMELINE_MAX_RECORDS =
    FP4PV_FWD_TIMELINE_EVENT_COUNT *
    FP4PV_FWD_TIMELINE_INDEX_SLOTS *
    FP4PV_FWD_TIMELINE_LANE_SLOTS;
__device__ unsigned long long fp4pv_forward_timeline[
    FP4PV_FWD_TIMELINE_MAX_RECORDS * FP4PV_FWD_TIMELINE_RECORD_U64];

__device__ __forceinline__ unsigned long long fp4pv_forward_timeline_pack_i32(int value) {
    return static_cast<unsigned long long>(static_cast<unsigned int>(value));
}

__device__ __forceinline__ int fp4pv_forward_timeline_normalize_idx(int idx) {
    int slot_idx = idx + 1;
    if (slot_idx < 0) {
        slot_idx = 0;
    }
    if (slot_idx >= FP4PV_FWD_TIMELINE_INDEX_SLOTS) {
        slot_idx = FP4PV_FWD_TIMELINE_INDEX_SLOTS - 1;
    }
    return slot_idx;
}

