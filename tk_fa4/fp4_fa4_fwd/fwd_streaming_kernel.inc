#if defined(TK_FA4_Q4_LARGE_PROBE_BUILD) || \
    defined(TK_FA4_FULLK_WAVE_PROBE_BUILD)
__device__ __forceinline__ void fp4pv_q4_large_role_record(
    unsigned long long event,
    int cur_bid,
    int task_num,
    int3 t_coord,
    int idx,
    int p_buf,
    int v_buf,
    int cta_rank,
    int role,
    int extra) {
    (void)task_num;
    (void)p_buf;
    (void)v_buf;
    (void)cta_rank;
    (void)role;
    (void)extra;
    if (fp4pv_q4_large_diag_control[2] == 0 || cur_bid < 0 ||
        cur_bid >= FP4PV_Q4_LARGE_DIAG_MAX_TASKS) {
        return;
    }

    int sample = -1;
    if (idx == (t_coord.y > 0 ? 1 : 0)) {
        sample = 0;
    } else if (idx == (t_coord.y >> 1)) {
        sample = 1;
    } else if (idx == t_coord.y) {
        sample = 2;
    }
    if (sample < 0) {
        return;
    }

    const int tid = static_cast<int>(threadIdx.x);
    int event_slot = -1;
    bool owner = false;
    switch (event) {
        case FP4PV_FWD_TL_QK_K_WAIT_BEGIN:
            event_slot = 0; owner = tid == 256; break;
        case FP4PV_FWD_TL_QK_K_WAIT_DONE:
            event_slot = 1; owner = tid == 256; break;
        case FP4PV_FWD_TL_QK_K_SCALE_WAIT_BEGIN:
            event_slot = 2; owner = tid == 256; break;
        case FP4PV_FWD_TL_QK_K_SCALE_WAIT_DONE:
            event_slot = 3; owner = tid == 256; break;
        case FP4PV_FWD_TL_QK_WAIT_DONE:
            event_slot = 4; owner = tid == 256; break;
        case FP4PV_FWD_TL_QK_ISSUE:
            event_slot = 5; owner = tid == 256; break;
        case FP4PV_FWD_TL_QK_COMMIT:
            event_slot = 6; owner = tid == 256; break;
        case FP4PV_FWD_TL_STAGE2_SCORE_WAIT_BEGIN:
            event_slot = 7; owner = tid == 128; break;
        case FP4PV_FWD_TL_STAGE2_SCORE_WAIT_DONE:
            event_slot = 8; owner = tid == 128; break;
        case FP4PV_FWD_TL_STAGE2_SCORE_TMEM_LOAD_BEGIN:
            event_slot = 9; owner = tid == 128; break;
        case FP4PV_FWD_TL_STAGE2_SCORE_TMEM_LOAD_DONE:
            event_slot = 10; owner = tid == 128; break;
        case FP4PV_FWD_TL_STAGE2_CAUSAL_MASK_DONE:
            event_slot = 11; owner = tid == 128; break;
        case FP4PV_FWD_TL_STAGE2_P_MAX_DONE:
            event_slot = 12; owner = tid == 128; break;
        case FP4PV_FWD_TL_STAGE2_P_ROW_SUM_CORR_DONE:
            event_slot = 13; owner = tid == 128; break;
        case FP4PV_FWD_TL_STAGE2_P_SCALE_DERIVED_DONE:
            event_slot = 14; owner = tid == 128; break;
        case FP4PV_FWD_TL_STAGE2_P_EXP_WEIGHT_DONE:
            event_slot = 15; owner = tid == 128; break;
        case FP4PV_FWD_TL_STAGE2_P_PAYLOAD_PACK_DONE:
            event_slot = 16; owner = tid == 128; break;
        case FP4PV_FWD_TL_STAGE2_P_SCALE_TMEM_DONE:
            event_slot = 17; owner = tid == 128; break;
        case FP4PV_FWD_TL_STAGE2_P_PAYLOAD_PUBLISH_DONE:
            event_slot = 18; owner = tid == 128; break;
        case FP4PV_FWD_TL_STAGE2_P_READY:
            event_slot = 19; owner = tid == 128; break;
        case FP4PV_FWD_TL_V_WAIT_BEGIN:
            event_slot = 20; owner = tid == 256; break;
        case FP4PV_FWD_TL_V_SCALE_READY:
            event_slot = 21; owner = tid == 256; break;
        case FP4PV_FWD_TL_PV_WAIT_BEGIN:
            event_slot = 22; owner = tid == 288; break;
        case FP4PV_FWD_TL_PV_ISSUE:
            event_slot = 23; owner = tid == 288; break;
        case FP4PV_FWD_TL_PV_COMMIT:
            event_slot = 24; owner = tid == 288; break;
        case FP4PV_FWD_TL_STAGE2_SCORE_COPY_RELEASE:
        case FP4PV_FWD_TL_HOTPLATE_SLOT_RELEASE:
            event_slot = 25; owner = tid == 128; break;
        default:
            break;
    }
    if (!owner || event_slot < 0) {
        return;
    }
    fp4pv_q4_large_diag_store(
        cur_bid, 16 + sample * 26 + event_slot, fp4pv_q4_large_globaltimer());
}
#ifdef TK_FA4_FULLK_WAVE_PROBE_BUILD
