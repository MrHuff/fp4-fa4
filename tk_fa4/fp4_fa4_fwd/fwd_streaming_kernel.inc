__device__ unsigned long long fp4pv_forward_pchain_stamps[FP4PV_FWD_PCHAIN_STAMP_COUNT];
#define FP4PV_PCHAIN_OWNER(task_id) \
    (((static_cast<unsigned long long>(blockIdx.x) + 1ULL) << 32) | \
     static_cast<unsigned long long>(static_cast<unsigned int>(task_id) + 1U))
#define FP4PV_PCHAIN_QUANT_STAMP(slot, idx, task_id) do { \
    if ((idx) == (consumer_mode) && \
        static_cast<int>(threadIdx.x) == 128) { \
        const unsigned long long pchain_owner = FP4PV_PCHAIN_OWNER(task_id); \
        if (fp4pv_forward_pchain_stamps[FP4PV_FWD_PCHAIN_OWNER_SLOT] == 0ULL) { \
            atomicCAS(&fp4pv_forward_pchain_stamps[FP4PV_FWD_PCHAIN_OWNER_SLOT], \
                      0ULL, pchain_owner); \
        } \
        if (fp4pv_forward_pchain_stamps[FP4PV_FWD_PCHAIN_OWNER_SLOT] == pchain_owner) { \
            fp4pv_forward_pchain_stamps[(slot)] = clock64(); \
        } \
    } \
} while (0)
#define FP4PV_PCHAIN_PV_STAMP(slot, idx, task_id) do { \
    if ((idx) == (consumer_mode) && \
        static_cast<int>(threadIdx.x) == PRODUCER_WG * 128 + 32) { \
        const unsigned long long pchain_owner = FP4PV_PCHAIN_OWNER(task_id); \
        if (fp4pv_forward_pchain_stamps[FP4PV_FWD_PCHAIN_OWNER_SLOT] == 0ULL) { \
            atomicCAS(&fp4pv_forward_pchain_stamps[FP4PV_FWD_PCHAIN_OWNER_SLOT], \
                      0ULL, pchain_owner); \
        } \
        if (fp4pv_forward_pchain_stamps[FP4PV_FWD_PCHAIN_OWNER_SLOT] == pchain_owner) { \
            fp4pv_forward_pchain_stamps[(slot)] = clock64(); \
        } \
    } \
} while (0)
#define FP4PV_PCHAIN_SPLIT_QUANT_STAMP(slot0, slot1, idx, task_id, half) do { \
    if ((idx) == (consumer_mode) && \
        static_cast<int>(threadIdx.x) == ((half) == 0 ? 128 : 256)) { \
        const unsigned long long pchain_owner = FP4PV_PCHAIN_OWNER(task_id); \
        if (fp4pv_forward_pchain_stamps[FP4PV_FWD_PCHAIN_OWNER_SLOT] == 0ULL) { \
            atomicCAS(&fp4pv_forward_pchain_stamps[FP4PV_FWD_PCHAIN_OWNER_SLOT], \
                      0ULL, pchain_owner); \
        } \
        if (fp4pv_forward_pchain_stamps[FP4PV_FWD_PCHAIN_OWNER_SLOT] == pchain_owner) { \
            fp4pv_forward_pchain_stamps[(half) == 0 ? (slot0) : (slot1)] = clock64(); \
        } \
    } \
} while (0)
#define FP4PV_PCHAIN_SPLIT_REUSE_STAMP(slot0, slot1, idx, task_id, half) do { \
    if ((idx) == (consumer_mode) + 2 && \
        static_cast<int>(threadIdx.x) == ((half) == 0 ? 128 : 256)) { \
        const unsigned long long pchain_owner = FP4PV_PCHAIN_OWNER(task_id); \
        if (fp4pv_forward_pchain_stamps[FP4PV_FWD_PCHAIN_OWNER_SLOT] == pchain_owner) { \
            fp4pv_forward_pchain_stamps[(half) == 0 ? (slot0) : (slot1)] = clock64(); \
        } \
    } \
} while (0)
#else
#define FP4PV_PCHAIN_QUANT_STAMP(slot, idx, task_id) do { } while (0)
#define FP4PV_PCHAIN_PV_STAMP(slot, idx, task_id) do { } while (0)
#define FP4PV_PCHAIN_SPLIT_QUANT_STAMP(slot0, slot1, idx, task_id, half) do { } while (0)
