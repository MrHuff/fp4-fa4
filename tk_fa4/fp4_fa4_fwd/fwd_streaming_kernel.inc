#if TK_FA4_NATIVE_GROUP2_SELECTED_ROW_TRACE_BUILD
                    if constexpr (STATIC_ONLINE_NATIVE_GROUP2_SELECTED_ROW_TRACE) {
                        fp4pv_native_group2_selected_row_record_softmax(
                            11,
                            t_coord,
                            m_tile,
                            idx,
                            scores_reg,
                            SCALE_LOG2,
                            row_max_old,
                            row_max,
                            acc_scale,
                            stats_load(lse_smem[0], warpgroup::laneid()));
