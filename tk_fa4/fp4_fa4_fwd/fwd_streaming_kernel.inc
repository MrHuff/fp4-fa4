		                                    local_block_max[qlocal],
		                                    fmaxf(scores_half[si].x, scores_half[si].y));
		                            }
	                            p_online_split_block_max[buf][p_half * 2 + qlocal][global_row] =
	                                local_block_max[qlocal];
	                        }
	                        fp4pv_publish_cta_shared_only();
	                        FP4PV_PCHAIN_SPLIT_QUANT_STAMP(
	                            23, 24, idx, quant_diag_cur_bid, p_half);
	                        warp::arrive(p_online_split_max_ready[buf]);
		                        const int split_max_phase =
		                            (p_online_split_max_phase_mask >> buf) & 1;
		                        wait(p_online_split_max_ready[buf], split_max_phase);
		                        p_online_split_max_phase_mask ^= (1 << buf);

	                        float acc_scale = 1.0f;
	                        if (warpgroup::groupid() == QUANT_WG0) {
	                            const float row_max_old = row_max;
	                            float tile_row_max =
	                                p_online_split_block_max[buf][0][global_row];
	                            tile_row_max = fmaxf(
	                                tile_row_max,
	                                p_online_split_block_max[buf][1][global_row]);
	                            tile_row_max = fmaxf(
	                                tile_row_max,
	                                p_online_split_block_max[buf][2][global_row]);
	                            tile_row_max = fmaxf(
	                                tile_row_max,
	                                p_online_split_block_max[buf][3][global_row]);
	                            row_max = fmaxf(row_max, tile_row_max);
	                            if ((idx >= m_tile || idx > 0) && !ZERO_SCALE) {
	                                acc_scale = softmax_rescale_factor_strict(
	                                    row_max, row_max_old, SCALE_LOG2);
	                            }
	                            p_online_split_tile_max[buf][0][global_row] = row_max;
	                            p_online_split_tile_sum[buf][0][global_row] = acc_scale;
	                            fp4pv_publish_cta_shared_only();
	                            warp::arrive(p_online_split_common_ready[buf]);
	                        } else {
	                            const int common_phase =
	                                (p_online_split_common_phase_mask >> buf) & 1;
	                            wait(p_online_split_common_ready[buf], common_phase);
	                            p_online_split_common_phase_mask ^= (1 << buf);
	                            row_max = p_online_split_tile_max[buf][0][global_row];
	                            acc_scale = p_online_split_tile_sum[buf][0][global_row];
	                        }

		                        uint8_t p_score_mx_e8m0[2];
		                        float p_score_mx_log2_coeff[2];
		                        float p_score_mx_rcp_coeff[2];
		                        uint16_t packed_half_scales = 0;
		                        #pragma unroll
		                        for (int qlocal = 0; qlocal < 2; ++qlocal) {
		                            uint8_t p_e8m0 = 0;
		                            const float block_max = local_block_max[qlocal];
		                            if (row_active && isfinite(block_max) && isfinite(row_max)) {
		                                const float block_scale_log2 =
		                                    FP4PV_MXFP4_ONLINE_LOG2_P_SCALE +
		                                    (block_max - row_max) * SCALE_LOG2;
		                                if constexpr (STATIC_ONLINE_MXFP4_SCORE_DERIVED_P_SCALE_MODE == 0) {
		                                    p_e8m0 = fp4pv_log2_to_e8m0_rte_finite(block_scale_log2);
		                                } else if constexpr (STATIC_ONLINE_MXFP4_SCORE_DERIVED_P_SCALE_MODE == 2) {
		                                    p_e8m0 = fp4pv_log2_to_e8m0_floor_finite(block_scale_log2);
		                                } else if constexpr (STATIC_ONLINE_MXFP4_SCORE_DERIVED_P_SCALE_MODE >= 0) {
