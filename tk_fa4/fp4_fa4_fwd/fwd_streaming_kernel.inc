                if (persistouter_clc_diag_quant_checkpoint(cur_bid, idx, 5)) {
                    return;
                }
#if TK_FA4_ENABLE_MXFP4_FWD_TIMELINE
                FP4PV_FWD_TIMELINE_RECORD_ACTIVE(
                    FP4PV_FWD_TL_STAGE2_P_STAGE_REUSE_WAIT_BEGIN,
                    quant_diag_cur_bid,
                    quant_diag_task_num,
                    quant_timeline_t_coord,
                    idx,
                    buf,
                    -1,
                    cta_rank,
                    warpgroup::groupid(),
                    0);
#endif
                if (!wait_for_p_stage_reusable(idx, buf)) {
                    return;
                }
#if TK_FA4_ENABLE_MXFP4_FWD_TIMELINE
                FP4PV_FWD_TIMELINE_RECORD_ACTIVE(
                    FP4PV_FWD_TL_STAGE2_P_STAGE_REUSE_WAIT_DONE,
                    quant_diag_cur_bid,
                    quant_diag_task_num,
                    quant_timeline_t_coord,
                    idx,
                    buf,
                    -1,
                    cta_rank,
                    warpgroup::groupid(),
                    0);
#endif
                FP4PV_PCHAIN_QUANT_STAMP(2, idx, quant_diag_cur_bid);
                if (persistouter_clc_diag_quant_checkpoint(cur_bid, idx, 6)) {
                    return;
                }
#ifdef TK_FA4_Q4_LARGE_PROBE_BUILD
                const int q4_ladder_stage = fp4pv_q4_large_diag_control[3];
                if (q4_ladder_stage == 1 ||
                    (q4_ladder_stage == 11 && idx == 0) ||
                    (q4_ladder_stage == 12 && idx == 1)) {
                    if (idx > 0) {
                        const int previous_buf =
                            fp4pv_p_stage_buf_for_idx<P_STAGE_SLOTS>(idx - 1);
                        const int previous_bit = 1 << previous_buf;
                        if ((p_stage_reuse_seen_mask & previous_bit) != 0) {
                            const int previous_phase =
                                (p_stage_reuse_phase_mask >> previous_buf) & 1;
                            wait(p_stage_reusable[previous_buf], previous_phase);
                            p_stage_reuse_phase_mask ^= previous_bit;
                            p_stage_reuse_seen_mask &= ~previous_bit;
