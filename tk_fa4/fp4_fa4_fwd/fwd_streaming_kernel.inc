	                if constexpr (STATIC_ONLINE_MXFP4_LAZY_OUTPUT_RESCALE) {
	                    output_lazy_log2_rcp = -output_lazy_log2;
	                }
	                    if constexpr (STATIC_ONLINE_MXFP4_PRE_P_QUANT_CORR_PUBLISH) {
		                    if (corr_reuse_ready_count >= STATIC_ONLINE_MXFP4_CORR_SLOTS) {
		                        const int reuse_phase = (corr_reuse_phase_mask >> corr_slot) & 1;
		                        wait(rescale_finished[corr_slot], reuse_phase);
		                        corr_reuse_phase_mask ^= (1 << corr_slot);
		                    }
			                    if (row_active) {
			                        stats_store(corr_vec_smem[corr_slot], warpgroup::laneid(), acc_scale);
			                    }
			                    warp::sync();
			                    warp::arrive(corr_arrived[corr_slot]);
			                    if (idx == 1) {
			                        quant_vmc_diag_mark(7);
			                    }
			                    ++corr_reuse_ready_count;
	                }
                if constexpr (!ONLINE) {
                    warp::sync();
                    warp::arrive(corr_arrived[0]);
                }

                if constexpr (STATIC_ONLINE_MXFP4_SCORE_DERIVED_P_SCALE_PACK &&
                              !STATIC_ONLINE_MXFP4_SCORE_DERIVED_P_FUSED_BLOCK_MAX) {
                    #pragma unroll
                    for (int qid = 0; qid < C::Nb / 32; ++qid) {
                        p_score_mx_max[qid] = base_types::constants<float>::neg_infty();
                        #pragma unroll
                        for (int jj = 0; jj < 16; ++jj) {
                            const int si = qid * 16 + jj;
                            p_score_mx_max[qid] = fmaxf(
                                p_score_mx_max[qid],
                                fmaxf(scores_reg[si].x, scores_reg[si].y));
                        }
	                    }
	                }

	                uint8_t p_score_mx_e8m0[C::Nb / 32];
	                float p_score_mx_log2_coeff[C::Nb / 32];
	                float p_score_mx_rcp_coeff[C::Nb / 32];
                uint32_t p_score_mx_packed_scales = 0;
                if constexpr (STATIC_ONLINE_MXFP4_SCORE_DERIVED_P_PRESCALED_PACK) {
                    #pragma unroll
                    for (int qid = 0; qid < C::Nb / 32; ++qid) {
                        uint8_t p_e8m0 = 0;
	                        const float block_max = p_score_mx_max[qid];
                        if (row_active && isfinite(block_max) && isfinite(row_max)) {
	                            float block_scale_log2 =
	                                FP4PV_MXFP4_ONLINE_LOG2_P_SCALE +
	                                (block_max - row_max) * SCALE_LOG2 +
	                                output_lazy_log2_rcp;
	                            if constexpr (STATIC_ONLINE_MXFP4_SCORE_DERIVED_P_SCALE_MODE >= 0) {
	                                if constexpr (STATIC_ONLINE_MXFP4_SCORE_DERIVED_P_SCALE_MODE == 0) {
	                                    p_e8m0 = fp4pv_log2_to_e8m0_rte_finite(block_scale_log2);
                                } else if constexpr (STATIC_ONLINE_MXFP4_SCORE_DERIVED_P_SCALE_MODE == 2) {
                                    p_e8m0 = fp4pv_log2_to_e8m0_floor_finite(block_scale_log2);
                                } else {
                                    p_e8m0 = fp4pv_log2_to_e8m0(
                                        block_scale_log2,
                                        STATIC_ONLINE_MXFP4_SCORE_DERIVED_P_SCALE_MODE);
                                }
                            } else {
                                p_e8m0 = fp4pv_log2_to_e8m0(block_scale_log2, g.p_quant_mode);
                            }
                        }
                        if constexpr (STATIC_REAL_FWD_P_SCALE_TMEM_SERVICE_CEILING) {
                            // Keep the exact dynamic derivation and its causal zero decision,
                            // but make the diagnostic payload use the same resident scale that
                            // PV consumes.  This avoids a payload/scale mismatch without
                            // changing the parent semaphore or publication lifecycle.
                            p_e8m0 = p_e8m0 == 0
                                ? 0
                                : FP4PV_MXFP4_ONLINE_FIXED_P_SCALE_E8M0;
                        }
                        p_score_mx_e8m0[qid] = p_e8m0;
                        p_score_mx_log2_coeff[qid] = (p_e8m0 == 0)
                            ? 0.0f
                            : (FP4PV_MXFP4_ONLINE_LOG2_6P_SCALE -
                               static_cast<float>(static_cast<int>(p_e8m0) - 127));
                        p_score_mx_rcp_coeff[qid] =
                            fp4pv_exp2f_e8m0(p_e8m0) * FP4PV_MXFP4_ONLINE_RCP_6P_SCALE;
                        if constexpr (!STATIC_ONLINE_MXFP4_SCORE_DERIVED_P_PACK_SCALES_LATE) {
                            p_score_mx_packed_scales |=
                                static_cast<uint32_t>(p_e8m0) << (qid * 8);
		                        }
		                    }
			                    if constexpr (STATIC_ONLINE_MXFP4_SCORE_DERIVED_P_PACK_SCALES_LATE) {
			                        #pragma unroll
			                        for (int qid = 0; qid < C::Nb / 32; ++qid) {
			                            p_score_mx_packed_scales |=
			                                static_cast<uint32_t>(p_score_mx_e8m0[qid]) << (qid * 8);
			                        }
			                    }
			                }
                record_stage2_p_marker(
                    FP4PV_FWD_TL_STAGE2_P_SCALE_DERIVED_DONE,
                    idx,
                    buf,
                    p_score_mx_packed_scales);
                FP4PV_PCHAIN_QUANT_STAMP(5, idx, quant_diag_cur_bid);
                if constexpr (STATIC_ONLINE_MXFP4_STAGE2_EARLY_ASYNC_P_SCALE_STORE) {
                    const int early_p_sc_slot = idx % P_SCALE_TMEM_SLOTS;
                    constexpr int P_SC_BASE = SCALE_TMEM_BASE + Q_SCALE_TMEM_WIDTH + K_SCALE_TMEM_WIDTH;
                    static_assert(P_SCALE_TMEM_SLOTS == 2,
                        "Stage2 early async P-scale store expects two folded scale slots");
                    d_tt_p_sc early_p_sc_tm0 =
