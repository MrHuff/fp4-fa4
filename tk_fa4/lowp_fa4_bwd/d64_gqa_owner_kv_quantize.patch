+    @cute.jit
+    def publish_owner_nvfp4_block(
+        self,
+        values: cute.Tensor,
+        row: Int32,
+        logical_head: Int32,
+        block: Int32,
+        owner_dq_fp4: cute.Tensor,
+        owner_dq_scales: cute.Tensor,
+        owner_dq_global_scale: cute.Tensor,
+    ):
+        global_decode = Float32(owner_dq_global_scale[0])
+        global_encode = cute.arch.rcp_approx(
+            cute.arch.fmax(global_decode, Float32(0.000000000001))
+        )
+        amax = Float32(0.0)
+        for i in cutlass.range_constexpr(16):
+            amax = cute.arch.fmax(amax, abs(Float32(values[i])))
+        packed_scale, local_decode = tk_encode_e4m3_f32(
+            amax * global_encode * Float32(1.0 / 6.0)
+        )
+        encode = cute.arch.rcp_approx(
+            cute.arch.fmax(
+                local_decode * global_decode,
+                Float32(0.000000000001),
+            )
+        )
+        payload_offset = logical_head * 64 + block * 8
+        for pair in cutlass.range_constexpr(8):
+            packed = tk_pack_e2m1_f32x2(
+                Float32(values[pair * 2]) * encode,
+                Float32(values[pair * 2 + 1]) * encode,
+            )
+            owner_dq_fp4[row, payload_offset + pair] = Uint8(packed)
+
+        local_row = row % 128
+        scale_row_offset = (local_row % 32) * 16 + (local_row // 32) * 4
+        owner_dq_scales[
+            row // 128,
+            logical_head * 2 + block // 4,
+            scale_row_offset + block % 4,
+        ] = Uint8(packed_scale)
