+# D128 MX-V dP integration spike.
+#
+# The producer ABI is deliberately described here rather than hidden behind a
+# scale-page reorder.  V is a logical [K, D, ((G, Hkv), B)] Float4 tensor.  G
+# has zero stride, so neither its payload nor its scales are replicated for
+# GQA.  The physical scale allocation is [B, ceil(K / 128), Hkv, 512], where
+# one 512-byte page uses the SM100 scale-factor address
+#
+#   (row % 32) * 16 + ((row // 32) % 4) * 4 + (column // 32).
+#
+# The packed payload keeps its nested zero-stride G mode for TMA.  The scale
+# page remains in producer order and is cooperatively preloaded as 128 x 4
+# contiguous bytes, avoiding a second logical scale layout or any G copies.
+TK_D128_MXFP4_DP_HEAD_DIM = 128
+TK_D128_MXFP4_DP_SF_VECTOR = 32
+TK_D128_MXFP4_DP_SCALE_PAGE_ROWS = 128
+TK_D128_MXFP4_DP_SCALE_PAGE_BYTES = 512
+TK_D128_MXFP4_DP_PAYLOAD_BYTES = 128 * 128 // 2
+TK_D128_MXFP4_DP_SHARED_SCALE_BYTES = 2 * 512
+TK_D128_MXFP4_DP_SFA_TMEM_COLUMNS = 16
+TK_D128_MXFP4_DP_RAW_TO_X16 = 2.0 / 3.0
+
+
+def tk_d128_mxfp4_v_payload_layout(k_seq, h_r, h_k, batch):
+    """Logical Float4 V with a zero-stride GQA group mode."""
+    d = TK_D128_MXFP4_DP_HEAD_DIM
+    return cute.make_layout(
+        (k_seq, d, ((h_r, h_k), batch)),
+        stride=(
+            d * h_k,
+            1,
+            ((0, d), k_seq * d * h_k),
+        ),
+    )
+
+
+def tk_d128_mxfp4_v_physical_scale_layout(k_seq, h_k, batch):
+    """Flat view of producer-owned [B, K/128, Hkv, 512] E8M0 pages."""
+    pages = k_seq // TK_D128_MXFP4_DP_SCALE_PAGE_ROWS
+    return cute.make_layout(
+        (
+            TK_D128_MXFP4_DP_SCALE_PAGE_BYTES,
+            pages,
+            h_k,
+            batch,
+        ),
+        stride=(
+            1,
+            h_k * TK_D128_MXFP4_DP_SCALE_PAGE_BYTES,
+            TK_D128_MXFP4_DP_SCALE_PAGE_BYTES,
+            pages * h_k * TK_D128_MXFP4_DP_SCALE_PAGE_BYTES,
+        ),
+    )
+
+
+# Correctness-first on-chip route:
+#
+# * the projection's row-major MX V payload is loaded once by TMA and its
+#   physical SFA page is cooperatively preloaded without a descriptor;
+# * the mixed FP4-by-E4M3 MMA consumes each resident E4M3(x4) dO stage
+#   directly with a one-time unity SFB page, so no second dO payload is
+#   quantized or published and the same dO bytes remain live for dV;
+# * SFA/SFB occupy TMEM columns [384,416), but only after compute releases the
+#   score tile in S[384,512); and
+# * a shadow dP completion wait proves the scale reads are dead before the
+#   next score MMA reclaims the aliased columns.
+#
+# The public flag remains false by default.  A second compile latch keeps an
+# explicitly enabled route fail-closed until a real SM100 CuTe compile has
+# validated the complete specialization.
+
+
