+@dsl_user_op
+def tk_lane_mod4_broadcast(value: Float32, *, loc=None, ip=None) -> Float32:
+    """Broadcast lanes 0..3 to the eight lanes sharing their lane modulo 4."""
+    result = llvm.inline_asm(
+        T.i32(),
+        [Float32(value).ir_value(loc=loc, ip=ip)],
+        """{
+        .reg .b32 broadcast;
+        .reg .u32 lane, source;
+        mov.u32 lane, %laneid;
+        and.b32 source, lane, 3;
+        shfl.sync.idx.b32 broadcast, $1, source, 31, -1;
+        mov.b32 $0, broadcast;
+        }""",
+        "=r,f",
+        has_side_effects=False,
+        is_align_stack=False,
+        asm_dialect=llvm.AsmDialect.AD_ATT,
+        loc=loc,
+        ip=ip,
+    )
+    return Float32(llvm.bitcast(Float32.mlir_type, result, loc=loc, ip=ip))
+
