+@dsl_user_op
+def tk_lane_mod4_max(value: Float32, *, loc=None, ip=None) -> Float32:
+    """Max over the eight warp lanes with the same lane modulo four."""
+    result = llvm.inline_asm(
+        T.i32(),
+        [Float32(value).ir_value(loc=loc, ip=ip)],
+        """{
+        .reg .f32 maximum, peer;
+        mov.b32 maximum, $1;
+        shfl.sync.bfly.b32 peer, maximum, 4, 31, -1;
+        max.f32 maximum, maximum, peer;
+        shfl.sync.bfly.b32 peer, maximum, 8, 31, -1;
+        max.f32 maximum, maximum, peer;
+        shfl.sync.bfly.b32 peer, maximum, 16, 31, -1;
+        max.f32 maximum, maximum, peer;
+        mov.b32 $0, maximum;
+        }""",
+        "=r,f",
+        has_side_effects=False,
+        is_align_stack=False,
+        asm_dialect=llvm.AsmDialect.AD_ATT,
+        loc=loc,
+        ip=ip,
+    )
+    return Float32(llvm.bitcast(Float32.mlir_type, result, loc=loc, ip=ip))
+
