+@dsl_user_op
+def tk_mxfp4_zero_invalid(
+    value: Float32, raw_exponent: Float32, *, loc=None, ip=None
+) -> Float32:
+    """Zero payloads whose forward E8M0 scale code saturated to zero."""
+    result = llvm.inline_asm(
+        T.i32(),
+        [
+            Float32(value).ir_value(loc=loc, ip=ip),
+            Float32(raw_exponent).ir_value(loc=loc, ip=ip),
+        ],
+        """{
+        .reg .pred valid;
+        .reg .f32 selected;
+        setp.gt.f32 valid, $2, 0fC2FE0000;
+        selp.f32 selected, $1, 0f00000000, valid;
+        mov.b32 $0, selected;
+        }""",
+        "=r,f,f",
+        has_side_effects=False,
+        is_align_stack=False,
+        asm_dialect=llvm.AsmDialect.AD_ATT,
+        loc=loc,
+        ip=ip,
+    )
+    return Float32(llvm.bitcast(Float32.mlir_type, result, loc=loc, ip=ip))
+
