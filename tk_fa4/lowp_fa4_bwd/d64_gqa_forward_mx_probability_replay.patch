+@dsl_user_op
+def tk_mxfp4_scale_exponent(
+    group_max_log2: Float32, *, loc=None, ip=None
+) -> Float32:
+    """Select the forward E8M0 code and return its unbiased exponent."""
+    result = llvm.inline_asm(
+        T.i32(),
+        [Float32(group_max_log2).ir_value(loc=loc, ip=ip)],
+        """{
+        .reg .f32 bounded;
+        .reg .s32 exponent;
+        max.f32 bounded, $1, 0fC2FE0000;
+        add.rn.f32 bounded, bounded, 0f3ED47FCC;
+        cvt.rmi.s32.f32 exponent, bounded;
+        max.s32 exponent, exponent, -127;
+        min.s32 exponent, exponent, 127;
+        cvt.rn.f32.s32 bounded, exponent;
+        mov.b32 $0, bounded;
+        }""",
+        "=r,f",
+        has_side_effects=False,
+        is_align_stack=False,
+        asm_dialect=llvm.AsmDialect.AD_ATT,
+        loc=loc,
+        ip=ip,
+    )
+    return Float32(llvm.bitcast(Float32.mlir_type, result, loc=loc, ip=ip))
+
+
+@dsl_user_op
+def tk_mxfp4_unpack_scale_exponent(
+    packed_scale: Int32, scale_group: Int32, *, loc=None, ip=None
+) -> Float32:
+    """Decode one stored forward E8M0 byte to the replay exponent."""
+    result = llvm.inline_asm(
+        T.i32(),
+        [
+            Int32(packed_scale).ir_value(loc=loc, ip=ip),
+            Int32(scale_group).ir_value(loc=loc, ip=ip),
+        ],
+        """{
+        .reg .pred invalid;
+        .reg .u32 code, shift;
+        .reg .s32 exponent;
+        .reg .f32 decoded;
+        shl.b32 shift, $2, 3;
+        shr.u32 code, $1, shift;
+        and.b32 code, code, 255;
+        sub.s32 exponent, code, 111;
+        setp.eq.u32 invalid, code, 0;
+        selp.s32 exponent, -127, exponent, invalid;
+        cvt.rn.f32.s32 decoded, exponent;
+        mov.b32 $0, decoded;
+        }""",
+        "=r,r,r",
+        has_side_effects=False,
+        is_align_stack=False,
+        asm_dialect=llvm.AsmDialect.AD_ATT,
+        loc=loc,
+        ip=ip,
+    )
+    return Float32(llvm.bitcast(Float32.mlir_type, result, loc=loc, ip=ip))
+
