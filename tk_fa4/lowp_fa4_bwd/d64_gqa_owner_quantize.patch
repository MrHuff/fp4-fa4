+            Int32(x2).ir_value(loc=loc, ip=ip),
+            Int32(x3).ir_value(loc=loc, ip=ip),
+        ],
+        """{
+        .reg .b32 b0, b1, b2, b3;
+        and.b32 b0, $1, 255;
+        and.b32 b1, $2, 255;
+        and.b32 b2, $3, 255;
+        and.b32 b3, $4, 255;
+        shl.b32 b1, b1, 8;
+        shl.b32 b2, b2, 16;
+        shl.b32 b3, b3, 24;
+        or.b32 b0, b0, b1;
+        or.b32 b2, b2, b3;
+        or.b32 $0, b0, b2;
+        }""",
+        "=r,r,r,r,r",
+        has_side_effects=False,
+        is_align_stack=False,
+        asm_dialect=llvm.AsmDialect.AD_ATT,
+        loc=loc,
+        ip=ip,
+    )
+    return Int32(result)
+
+
+@dsl_user_op
+def tk_inverse_rope_bf16_pair(
+    x: Float32,
+    y: Float32,
+    packed_rope: Int32,
+    *,
+    loc=None,
+    ip=None,
+) -> Tuple[Float32, Float32]:
+    result = llvm.inline_asm(
+        llvm.StructType.get_literal([T.i32(), T.i32()]),
+        [
+            Float32(x).ir_value(loc=loc, ip=ip),
+            Float32(y).ir_value(loc=loc, ip=ip),
+            Int32(packed_rope).ir_value(loc=loc, ip=ip),
+        ],
+        """{
+        .reg .b16 cos_bf16, sin_bf16;
+        .reg .f32 cosine, sine, rx, ry, tmp, neg_x;
+        mov.b32 {cos_bf16, sin_bf16}, $4;
+        cvt.f32.bf16 cosine, cos_bf16;
+        cvt.f32.bf16 sine, sin_bf16;
+        mul.rn.f32 tmp, $2, cosine;
+        fma.rn.f32 rx, $3, sine, tmp;
+        neg.f32 neg_x, $2;
+        mul.rn.f32 tmp, $3, cosine;
+        fma.rn.f32 ry, neg_x, sine, tmp;
+        mov.b32 $0, rx;
+        mov.b32 $1, ry;
+        }""",
+        "=r,=r,f,f,r",
+        has_side_effects=False,
+        is_align_stack=False,
+        asm_dialect=llvm.AsmDialect.AD_ATT,
+        loc=loc,
+        ip=ip,
+    )
+    rx = llvm.extractvalue(T.i32(), result, [0], loc=loc, ip=ip)
+    ry = llvm.extractvalue(T.i32(), result, [1], loc=loc, ip=ip)
+    return (
+        Float32(llvm.bitcast(Float32.mlir_type, rx, loc=loc, ip=ip)),
+        Float32(llvm.bitcast(Float32.mlir_type, ry, loc=loc, ip=ip)),
+    )
+
+
+@dsl_user_op
+def tk_encode_e4m3_f32(
+    value: Float32,
+    *,
+    loc=None,
+    ip=None,
+) -> Tuple[Int32, Float32]:
+    result = llvm.inline_asm(
+        llvm.StructType.get_literal([T.i32(), T.i32()]),
+        [Float32(value).ir_value(loc=loc, ip=ip)],
+        """{
+        .reg .b16 packed;
+        .reg .b32 half2;
+        .reg .b16 half0, half1;
+        .reg .pred value_is_nan;
+        .reg .f32 clamped;
+        .reg .f32 decoded;
+        setp.nan.f32 value_is_nan, $2, $2;
+        selp.f32 clamped, 0f43E00000, $2, value_is_nan;
+        min.f32 clamped, clamped, 0f43E00000;
+        cvt.rn.satfinite.e4m3x2.f32 packed, clamped, clamped;
+        cvt.rn.f16x2.e4m3x2 half2, packed;
+        mov.b32 {half0, half1}, half2;
+        cvt.f32.f16 decoded, half0;
+        cvt.u32.u8 $0, packed;
+        mov.b32 $1, decoded;
+        }""",
+        "=r,=r,f",
+        has_side_effects=False,
+        is_align_stack=False,
+        asm_dialect=llvm.AsmDialect.AD_ATT,
+        loc=loc,
+        ip=ip,
+    )
+    packed = llvm.extractvalue(T.i32(), result, [0], loc=loc, ip=ip)
+    decoded = llvm.extractvalue(T.i32(), result, [1], loc=loc, ip=ip)
+    return (
+        Int32(packed),
+        Float32(llvm.bitcast(Float32.mlir_type, decoded, loc=loc, ip=ip)),
+    )
+
