+def tk_pack_e2m1_f32x2(
+    x: Float32,
+    y: Float32,
+    *,
+    loc=None,
+    ip=None,
+) -> Int32:
+    result = llvm.inline_asm(
+        T.i32(),
+        [
+            Float32(x).ir_value(loc=loc, ip=ip),
+            Float32(y).ir_value(loc=loc, ip=ip),
+        ],
+        """{
+        .reg .b8 packed;
+        cvt.rn.satfinite.e2m1x2.f32 packed, $2, $1;
+        cvt.u32.u8 $0, packed;
+        }""",
+        "=r,f,f",
+        has_side_effects=False,
+        is_align_stack=False,
+        asm_dialect=llvm.AsmDialect.AD_ATT,
+        loc=loc,
+        ip=ip,
+    )
+    return Int32(result)
+
+
+@dsl_user_op
+def tk_pack_u8x4(
+    x0: Int32,
+    x1: Int32,
+    x2: Int32,
+    x3: Int32,
+    *,
+    loc=None,
+    ip=None,
+) -> Int32:
+    result = llvm.inline_asm(
